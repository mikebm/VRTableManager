{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/csharpier-format.sh\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Formatting with CSharpier"
          }
        ]
      }
    ]
  }
}
