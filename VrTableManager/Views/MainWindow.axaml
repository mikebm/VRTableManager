<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VrTableManager.ViewModels"
        xmlns:v="using:VrTableManager.Views"
        xmlns:services="using:VrTableManager.Services"
        x:Class="VrTableManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VR Table Manager"
        Icon="/Assets/app.ico"
        Width="1360" Height="880" MinWidth="980" MinHeight="640">

  <Window.Resources>
    <!-- A table card's add-on menu (PUP / COLOUR DMD / ALTSOUND): the catalog's files, open folder, remove. -->
    <DataTemplate x:Key="AddonButton" x:DataType="vm:AddonSlot">
      <Button Classes="small" Content="{Binding ButtonText}" Margin="0,0,6,6" IsEnabled="{Binding !Item.IsBusy}" ToolTip.Tip="{Binding Tip}">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="{Binding MenuHeader}" IsVisible="{Binding HasChoices}" ItemsSource="{Binding Choices}">
              <MenuItem.ItemTemplate>
                <DataTemplate x:DataType="vm:AddonChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </MenuItem.ItemTemplate>
              <MenuItem.Styles>
                <Style Selector="MenuItem > MenuItem" x:DataType="vm:AddonChoice">
                  <Setter Property="Command" Value="{Binding Slot.Item.Owner.GetAddonCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <MenuItem Header="{Binding FileMenuHeader}" IsVisible="{Binding CanAddFile}" Command="{Binding Item.Owner.InstallAddonFileCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Open folder" IsVisible="{Binding IsInstalled}" Command="{Binding Item.Owner.OpenAddonFolderCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Remove" IsVisible="{Binding IsInstalled}" Command="{Binding Item.Owner.RemoveAddonCommand}" CommandParameter="{Binding}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- Card grids are ListBoxes with a WrapPanel; strip the default row chrome. -->
    <Style Selector="ListBox.grid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.grid ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,16,16" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected Border.tile">
      <Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="PathIcon.search">
      <Setter Property="Data" Value="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- Setup's section rail: each section is a lamp switch, lit like the top tabs when it's the one showing.
         Radio buttons with their own template (no dot), so exactly one is on and the keyboard can move between them. -->
    <Style Selector="RadioButton.setupNav">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="navBack" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="navContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton.setupNav:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.setupNav:checked">
      <Setter Property="Background" Value="{StaticResource LampSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
      <Setter Property="Foreground" Value="{StaticResource Lamp}" />
    </Style>
    <Style Selector="RadioButton.setupNav:checked /template/ Border#navBack">
      <Setter Property="BoxShadow" Value="0 0 14 0 #33FFB23E" />
    </Style>
    <Style Selector="RadioButton.setupNav TextBlock.navNum">
      <Setter Property="FontFamily" Value="{StaticResource DmdFont}" />
      <Setter Property="FontWeight" Value="Black" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="RadioButton.setupNav TextBlock.navTitle">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="RadioButton.setupNav TextBlock.navSub">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.railGroup">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="Foreground" Value="#6E6E77" />
      <Setter Property="Margin" Value="10,14,0,4" />
    </Style>
    <!-- A Setup page sits in a grid column capped at 980 px, so it fills the width up to that from the left
         (a StackPanel with a MaxWidth of its own would centre itself in a wide window). -->
    <Style Selector="StackPanel.setupPage">
      <Setter Property="Margin" Value="32,24,32,32" />
      <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="StackPanel.setupHead">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.setupNext">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- Header bar behind the nav tabs -->
    <!-- Black lacquer with a chrome trim line, like a cabinet's lockbar edge -->
    <Border Height="66" VerticalAlignment="Top">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#1A1A1D" />
          <GradientStop Offset="1" Color="#0A0A0B" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Height="2" Margin="0,64,0,0" VerticalAlignment="Top" Background="{StaticResource Chrome}" Opacity="0.55" />

    <TabControl Classes="nav">
      <TabControl.Styles>
        <Style Selector="TabControl.nav /template/ ItemsPresenter#PART_ItemsPresenter">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Margin" Value="0,14,24,14" />
        </Style>
      </TabControl.Styles>

      <!-- ================= My tables ================= -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="MY TABLES" VerticalAlignment="Center" />
            <Border Classes="chip hot" Padding="6,1" VerticalAlignment="Center"
                    IsVisible="{Binding TableUpdateCount, Converter={x:Static v:Converters.NonZero}}"
                    ToolTip.Tip="Table updates available">
              <TextBlock Text="{Binding TableUpdateCount}" />
            </Border>
          </StackPanel>
        </TabItem.Header>
        <!-- Everything above the cards stays put; only the cards scroll. -->
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="28,14,28,6" Spacing="10">
            <!-- One line: title and count, buttons on the right. How Play works is the title's tooltip. -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                          ToolTip.Tip="Hit Play in VR, then put your headset on. This window gets out of the way and comes back when the table closes, so you can pick the next one.">
                <TextBlock Classes="h2" Text="My Tables" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Text="{Binding InstalledTotal, StringFormat='{}{0} INSTALLED'}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="＋  ADD A TABLE FILE…" Command="{Binding AddTableFileCommand}"
                        ToolTip.Tip="Install a table zip (or .vpx / .fpt) you already downloaded yourself" />
                <Button Content="⟳  RESCAN" Command="{Binding RefreshInstalledCommand}" />
                <Button Content="●  RECORD LOBBY VIDEOS" Command="{Binding RecordAllLobbyVideosCommand}" IsVisible="{Binding !IsBatchRecording}"
                        ToolTip.Tip="Records a moving playfield in VPX for every table that has none, one after another (about 40 s each). Ramps and toys stand up in the VR lobby only on tables with one." />
                <Button Content="{Binding BatchRecordingText}" Command="{Binding StopBatchRecordingCommand}" IsVisible="{Binding IsBatchRecording}"
                        ToolTip.Tip="Stops the recording that's running and skips the rest" />
                <Button Classes="primary" Content="◉  LAUNCH VR LOBBY" Command="{Binding LaunchLobbyCommand}"
                        IsEnabled="{Binding !IsLobbyRunning}"
                        ToolTip.Tip="Pick and play tables inside the headset. First time: downloads Godot (117 MB) and builds the lobby." />
              </StackPanel>
            </Grid>
            <TextBlock Foreground="{StaticResource Lamp}" FontWeight="SemiBold" Text="{Binding PlayStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding PlayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Table updates banner: one slim line -->
            <Border CornerRadius="10" Padding="14,6" BorderBrush="{StaticResource Insert}" BorderThickness="1" Background="#14E5483B"
                    IsVisible="{Binding TableUpdateCount, Converter={x:Static v:Converters.NonZero}}"
                    ToolTip.Tip="Authors released newer versions. Updating keeps your ROMs, high scores and table settings.">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="18" Foreground="{StaticResource Insert}"
                           Text="{Binding TableUpdateCount}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Classes="title" Text="{Binding TableUpdateText}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="primary" Content="UPDATE ALL TABLES" Command="{Binding UpdateAllTablesCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <WrapPanel IsVisible="{Binding InstalledTotal, Converter={x:Static v:Converters.NonZero}}">
              <TextBox Text="{Binding InstalledSearch}" PlaceholderText="Search your tables" Width="260" Margin="0,0,12,8">
                <TextBox.InnerLeftContent>
                  <PathIcon Classes="search" Margin="12,0,0,0" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <ListBox Classes="segmented" ItemsSource="{Binding InstalledFilters}" SelectedItem="{Binding InstalledFilter}" Margin="0,0,12,8" />
              <ComboBox ItemsSource="{Binding InstalledEngines}" SelectedItem="{Binding InstalledEngine}" MinWidth="150" Margin="0,0,12,8" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8" VerticalAlignment="Center">
                <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="SORT" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding InstalledSorts}" SelectedItem="{Binding InstalledSort}" MinWidth="170"
                          ToolTip.Tip="Used with All; the other lists have their own order" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8" VerticalAlignment="Center">
                <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="SIZE" VerticalAlignment="Center" />
                <ListBox Classes="segmented" ItemsSource="{Binding CardSizes}" SelectedItem="{Binding CardSize}"
                         ToolTip.Tip="Card size: Text shows no pictures, so many more tables fit" />
              </StackPanel>
              <TextBlock Classes="mono" VerticalAlignment="Center" Margin="0,0,0,8"
                         Text="{Binding InstalledSizeText, StringFormat='{}{0} on disk'}"
                         ToolTip.Tip="Favourites and plays are shared with the VR lobby" />
            </WrapPanel>
            <TextBlock Classes="body" Text="{Binding InstalledEmptyText}"
                       IsVisible="{Binding InstalledEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Classes="panel" IsVisible="{Binding InstalledTotal, Converter={x:Static v:Converters.IsZero}}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="No tables yet" />
                <TextBlock Classes="body" Text="Go to Get Tables, pick a table with the VR badge and press Install." />
              </StackPanel>
            </Border>
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Installed}" Margin="28,8,28,28">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InstalledItem">
                  <Border Classes="tile" Width="{ReflectionBinding $parent[Window].DataContext.CardWidth}" Margin="0,0,16,16" Cursor="Arrow">
                    <DockPanel>
                      <Border Classes="tileArt" DockPanel.Dock="Top" Height="{ReflectionBinding $parent[Window].DataContext.CardArtHeight}"
                            IsVisible="{ReflectionBinding $parent[Window].DataContext.ShowCardArt}">
                      <Grid>
                        <Border Background="{StaticResource Stripes}" />
                        <TextBlock Classes="mono" Text="NO ARTWORK" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasImage}" />
                        <Image v:ImageLoader.Url="{Binding ImgUrl}" Stretch="UniformToFill" />
                        <Border Background="{StaticResource CardFade}" />
                        <Border Classes="chip" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{ReflectionBinding $parent[Window].DataContext.BadgesOnArt}">
                          <TextBlock Text="{Binding EngineBadge}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsVisible="{ReflectionBinding $parent[Window].DataContext.BadgesOnArt}">
                          <Border Classes="chip hot" IsVisible="{Binding IsIncomplete}"><TextBlock Text="INCOMPLETE" /></Border>
                          <Border Classes="chip hot" IsVisible="{Binding HasUpdate}"><TextBlock Text="UPDATE" /></Border>
                          <Border Classes="chip hot" IsVisible="{Binding NeedsRom}"><TextBlock Text="NEEDS ROM" /></Border>
                          <Border Classes="chip" IsVisible="{Binding Pup.IsInstalled}" ToolTip.Tip="{Binding Pup.Status}"><TextBlock Text="PUP" /></Border>
                          <Border Classes="chip" IsVisible="{Binding Colour.IsInstalled}" ToolTip.Tip="{Binding Colour.Status}"><TextBlock Text="COLOUR" /></Border>
                          <Border Classes="chip" IsVisible="{Binding Sound.IsInstalled}" ToolTip.Tip="{Binding Sound.Status}"><TextBlock Text="ALTSOUND" /></Border>
                        </StackPanel>
                      </Grid>
                      </Border>
                      <DockPanel Margin="14,12,14,14">
                        <!-- Play and the other buttons sit at the bottom, lined up across a row of cards. -->
                        <StackPanel DockPanel.Dock="Bottom">
                          <Button Classes="primary" Content="⟳  REINSTALL" Margin="0,8,0,0" IsVisible="{Binding IsIncomplete}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsEnabled="{Binding !IsBusy}" Command="{ReflectionBinding $parent[Window].DataContext.ReinstallCommand}" CommandParameter="{Binding}" />
                          <WrapPanel Margin="0,4,0,0">
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="DESKTOP" Margin="0,0,6,6" IsVisible="{Binding CanPlayDesktop}"
                                      Command="{ReflectionBinding $parent[Window].DataContext.PlayDesktopCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small primary" Content="GET ROM" Margin="0,0,6,6" IsVisible="{Binding CanGetRom}"
                                      ToolTip.Tip="Download this table's ROM from the catalog (usually VPForums) and install it"
                                      IsEnabled="{Binding !IsBusy}" Command="{ReflectionBinding $parent[Window].DataContext.GetRomCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="ALL ROMS" Margin="0,0,6,6" IsVisible="{Binding CanGetAllRoms}"
                                      ToolTip.Tip="Download every ROM version from this table's ROM page (some versions need another one beside them)"
                                      IsEnabled="{Binding !IsBusy}" Command="{ReflectionBinding $parent[Window].DataContext.GetRomCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="SEARCH VPUNIVERSE" Margin="0,0,6,6" IsVisible="{Binding RomUnavailable}"
                                      ToolTip.Tip="Search VPUniverse's files for this ROM in your browser"
                                      Command="{ReflectionBinding $parent[Window].DataContext.SearchRomCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="ADD ROM" Margin="0,0,6,6" IsVisible="{Binding NeedsRom}"
                                      ToolTip.Tip="Install a ROM zip you already have"
                                      Command="{ReflectionBinding $parent[Window].DataContext.AddRomCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <ContentControl Content="{Binding Pup}" ContentTemplate="{StaticResource AddonButton}" IsVisible="{Binding Pup.ShowButton}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <ContentControl Content="{Binding Colour}" ContentTemplate="{StaticResource AddonButton}" IsVisible="{Binding Colour.ShowButton}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <ContentControl Content="{Binding Sound}" ContentTemplate="{StaticResource AddonButton}" IsVisible="{Binding Sound.ShowButton}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="RULES ▾" Margin="0,0,6,6" IsVisible="{Binding HasRules}"
                                      ToolTip.Tip="How to play it: The Pinball Primer's rules and strategy, and instruction cards (opens in your browser)">
                                <Button.Flyout>
                                  <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ItemsControl ItemsSource="{Binding Rules}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RuleChoice">
                                          <Button Classes="small" Content="{Binding Label}" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  Command="{Binding Item.Owner.OpenPageCommand}" CommandParameter="{Binding Url}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small" Content="FOLDER" Margin="0,0,6,6"
                                      Command="{ReflectionBinding $parent[Window].DataContext.OpenTableFolderCommand}" CommandParameter="{Binding}" />
                            </Panel>
                            <Panel IsVisible="{Binding !Compact}">
                              <Button Classes="small danger" Content="REMOVE" Margin="0,0,6,6" IsVisible="{Binding CanRemove}"
                                    Command="{ReflectionBinding $parent[Window].DataContext.RemoveCommand}" CommandParameter="{Binding}" />
                            </Panel>
                          </WrapPanel>
                          <!-- The bottom row of every card: Play and MORE, lined up across a row of cards. -->
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Button Grid.Column="0" Classes="primary" Content="{ReflectionBinding $parent[Window].DataContext.PlayLabel}" IsVisible="{Binding CanPlay}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{ReflectionBinding $parent[Window].DataContext.PlayVrCommand}" CommandParameter="{Binding}" />
                          <Button Grid.Column="1" Classes="small" Content="⋯" FontSize="20" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="More: desktop play, add-ons, rules, folders, artwork, per-table settings">
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <!-- Compact cards (below Large): the card's other buttons live here. -->
                                <MenuItem Header="Play on desktop" Command="{Binding Owner.PlayDesktopCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="CanPlayDesktop" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <MenuItem Header="Get ROM" Command="{Binding Owner.GetRomCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="CanGetRom" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <MenuItem Header="Get all ROM versions" Command="{Binding Owner.GetRomCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="CanGetAllRoms" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <MenuItem Header="Search VPUniverse for the ROM" Command="{Binding Owner.SearchRomCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="RomUnavailable" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <MenuItem Header="Add a ROM zip you have…" Command="{Binding Owner.AddRomCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="NeedsRom" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <MenuItem Header="{Binding Pup.Name}" IsEnabled="{Binding !IsBusy}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="Pup.ShowButton" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                  <MenuItem Header="{Binding Pup.MenuHeader}" IsVisible="{Binding Pup.HasChoices}" ItemsSource="{Binding Pup.Choices}">
                                    <MenuItem.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AddonChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </MenuItem.ItemTemplate>
                                    <MenuItem.Styles>
                                      <Style Selector="MenuItem > MenuItem" x:DataType="vm:AddonChoice">
                                        <Setter Property="Command" Value="{Binding Slot.Item.Owner.GetAddonCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                      </Style>
                                    </MenuItem.Styles>
                                  </MenuItem>
                                  <MenuItem Header="{Binding Pup.FileMenuHeader}" IsVisible="{Binding Pup.CanAddFile}" Command="{Binding Owner.InstallAddonFileCommand}" CommandParameter="{Binding Pup}" />
                                  <MenuItem Header="Open folder" IsVisible="{Binding Pup.IsInstalled}" Command="{Binding Owner.OpenAddonFolderCommand}" CommandParameter="{Binding Pup}" />
                                  <MenuItem Header="Remove" IsVisible="{Binding Pup.IsInstalled}" Command="{Binding Owner.RemoveAddonCommand}" CommandParameter="{Binding Pup}" />
                                </MenuItem>
                                <MenuItem Header="{Binding Colour.Name}" IsEnabled="{Binding !IsBusy}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="Colour.ShowButton" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                  <MenuItem Header="{Binding Colour.MenuHeader}" IsVisible="{Binding Colour.HasChoices}" ItemsSource="{Binding Colour.Choices}">
                                    <MenuItem.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AddonChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </MenuItem.ItemTemplate>
                                    <MenuItem.Styles>
                                      <Style Selector="MenuItem > MenuItem" x:DataType="vm:AddonChoice">
                                        <Setter Property="Command" Value="{Binding Slot.Item.Owner.GetAddonCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                      </Style>
                                    </MenuItem.Styles>
                                  </MenuItem>
                                  <MenuItem Header="Open folder" IsVisible="{Binding Colour.IsInstalled}" Command="{Binding Owner.OpenAddonFolderCommand}" CommandParameter="{Binding Colour}" />
                                  <MenuItem Header="Remove" IsVisible="{Binding Colour.IsInstalled}" Command="{Binding Owner.RemoveAddonCommand}" CommandParameter="{Binding Colour}" />
                                </MenuItem>
                                <MenuItem Header="{Binding Sound.Name}" IsEnabled="{Binding !IsBusy}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="Sound.ShowButton" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                  <MenuItem Header="{Binding Sound.MenuHeader}" IsVisible="{Binding Sound.HasChoices}" ItemsSource="{Binding Sound.Choices}">
                                    <MenuItem.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AddonChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </MenuItem.ItemTemplate>
                                    <MenuItem.Styles>
                                      <Style Selector="MenuItem > MenuItem" x:DataType="vm:AddonChoice">
                                        <Setter Property="Command" Value="{Binding Slot.Item.Owner.GetAddonCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                      </Style>
                                    </MenuItem.Styles>
                                  </MenuItem>
                                  <MenuItem Header="Open folder" IsVisible="{Binding Sound.IsInstalled}" Command="{Binding Owner.OpenAddonFolderCommand}" CommandParameter="{Binding Sound}" />
                                  <MenuItem Header="Remove" IsVisible="{Binding Sound.IsInstalled}" Command="{Binding Owner.RemoveAddonCommand}" CommandParameter="{Binding Sound}" />
                                </MenuItem>
                                <MenuItem Header="Rules" ItemsSource="{Binding Rules}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="HasRules" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                  <MenuItem.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                  </MenuItem.ItemTemplate>
                                  <MenuItem.Styles>
                                    <Style Selector="MenuItem > MenuItem" x:DataType="vm:RuleChoice">
                                      <Setter Property="Command" Value="{Binding Item.Owner.OpenPageCommand}" />
                                      <Setter Property="CommandParameter" Value="{Binding Url}" />
                                    </Style>
                                  </MenuItem.Styles>
                                </MenuItem>
                                <MenuItem Header="Open table folder" Command="{Binding Owner.OpenTableFolderCommand}" CommandParameter="{Binding}" IsVisible="{Binding Compact}" />
                                <MenuItem Header="Remove table…" Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}">
                                <MenuItem.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Compact" />
                                    <Binding Path="CanRemove" />
                                  </MultiBinding>
                                </MenuItem.IsVisible>
                                </MenuItem>
                                <Separator IsVisible="{Binding Compact}" />
                                <MenuItem Header="{Binding SourcePageMenuHeader}" IsVisible="{Binding HasSourcePage}"
                                          ToolTip.Tip="The page the author posted this table on: rate it, leave a comment, report a problem or say thanks"
                                          Command="{Binding Owner.OpenPageCommand}" CommandParameter="{Binding SourcePage}" />
                                <MenuItem Header="Open ROM folder" IsVisible="{Binding IsVpx}" Command="{Binding Owner.OpenRomFolderCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Open high score (NVRAM) folder" IsVisible="{Binding IsVpx}" Command="{Binding Owner.OpenNvramFolderCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Edit this table's VPX settings (.ini)" IsVisible="{Binding IsVpx}" Command="{Binding Owner.OpenTableIniCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="{Binding ScaleMenuHeader}" IsVisible="{Binding IsVpx}" ItemsSource="{Binding ScaleChoices}">
                                  <MenuItem.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TableScaleChoice">
                                      <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                  </MenuItem.ItemTemplate>
                                  <MenuItem.Styles>
                                    <Style Selector="MenuItem > MenuItem" x:DataType="vm:TableScaleChoice">
                                      <Setter Property="Command" Value="{Binding Item.Owner.SetTableScaleCommand}" />
                                      <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                  </MenuItem.Styles>
                                </MenuItem>
                                <MenuItem Header="{Binding VrHeightMenuHeader}" IsVisible="{Binding HasVrHeight}"
                                          ToolTip.Tip="You raised or lowered this table in the headset, and it keeps that height. Clear it to sit at the same height as every table."
                                          Command="{Binding Owner.ClearTableVrHeightCommand}" CommandParameter="{Binding}" />
                                <Separator IsVisible="{Binding IsVpx}" />
                                <MenuItem Header="{Binding AttractAudioMenuHeader}" IsVisible="{Binding CanGetAttractAudio}"
                                          ToolTip.Tip="Download this table's sound file or media pack and keep only its audio, as music\attract (the pack's videos are deleted)"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.GetAttractAudioCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Remove attract audio" IsVisible="{Binding HasAttractAudio}" Command="{Binding Owner.RemoveAttractAudioCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="{Binding LobbyVideoMenuHeader}" IsVisible="{Binding CanHaveLobbyVideo}"
                                          ToolTip.Tip="A moving playfield for this table's cabinet in the VR lobby: the playfield video from the catalog's media pack, or VPX's own recording of the attract mode when there isn't one"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.GetLobbyVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Record lobby video in VPX" IsVisible="{Binding HasMediaPack}"
                                          ToolTip.Tip="Records the attract mode with VPX instead of using the media pack (a small VPX window opens for about half a minute, sound off)"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.RecordLobbyVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Use my own lobby video…" IsVisible="{Binding CanHaveLobbyVideo}"
                                          ToolTip.Tip="Turns a video file you have (.mp4 works best) into this cabinet's moving playfield in the VR lobby; the first 12 seconds loop"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.UseOwnLobbyVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="{Binding LoadingVideoMenuHeader}" IsVisible="{Binding CanGetLoadingVideo}"
                                          ToolTip.Tip="A video the VR lobby plays on a big screen, with its sound, while this table starts: the loading video from the catalog's media pack (the pack's other files are deleted)"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.GetLoadingVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="{Binding OwnLoadingVideoMenuHeader}" IsVisible="{Binding CanHaveLoadingVideo}"
                                          ToolTip.Tip="Turns a video file you have (.mp4 works best) into the video the VR lobby plays while this table starts, with its sound; the first 30 seconds, looping if the table takes longer"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.UseOwnLoadingVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="{Binding WheelArtMenuHeader}" IsVisible="{Binding CanGetWheelArt}"
                                          ToolTip.Tip="The game's logo, shown over the cabinet in the VR lobby when you pick it: from the catalog's wheel art, or its media pack's Wheel folder"
                                          IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.GetWheelArtCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="My artwork"
                                          ToolTip.Tip="Your own pictures win over the catalog's and the table's. They're kept in the table's artwork folder (card, playfield, backglass, wheel .png/.jpg), where you can also put them by hand">
                                  <MenuItem Header="Card picture in My Tables…" Command="{Binding Owner.ChooseCardArtCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="VR lobby playfield picture…" Command="{Binding Owner.ChoosePlayfieldArtCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="VR lobby backglass picture…" Command="{Binding Owner.ChooseBackglassArtCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="VR lobby wheel art (the game's logo)…" Command="{Binding Owner.ChooseWheelArtCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="A logo on a transparent background (.png) works best, like a front end's wheel image" />
                                  <MenuItem Header="Open the artwork folder" Command="{Binding Owner.OpenArtworkFolderCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Remove my pictures" IsVisible="{Binding HasUserArtwork}" Command="{Binding Owner.RemoveUserArtworkCommand}" CommandParameter="{Binding}" />
                                </MenuItem>
                                <MenuItem Header="Remove lobby video" IsVisible="{Binding HasLobbyVideo}" IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.RemoveLobbyVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Remove loading video" IsVisible="{Binding HasLoadingVideo}" IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.RemoveLoadingVideoCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Remove wheel art" IsVisible="{Binding HasWheelArt}" IsEnabled="{Binding !IsBusy}" Command="{Binding Owner.RemoveWheelArtCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Fix the PuP DMD for VR" IsVisible="{Binding CanApplyDmdFix}"
                                          ToolTip.Tip="Shows the PuP pack's DMD on the VR cabinet in VPX 10.8.1 (switches the table's PuP display to VPX's Score View; the original file is kept)"
                                          Command="{Binding Owner.ApplyDmdFixCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Undo the PuP DMD fix (put the original table back)" IsVisible="{Binding HasDmdFix}"
                                          ToolTip.Tip="Restores the table file saved before its VR DMD was switched to VPX's Score View"
                                          Command="{Binding Owner.UndoDmdFixCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Clear texture cache" IsVisible="{Binding IsVpx}" Command="{Binding Owner.ClearTableCacheCommand}" CommandParameter="{Binding}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                          </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4" VerticalAlignment="Top" Margin="0,0,0,4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Padding="6,2" BorderThickness="0" FontSize="20"
                                    Content="{Binding IsFavourite, Converter={x:Static v:Converters.Star}}"
                                    Foreground="{Binding IsFavourite, Converter={x:Static v:Converters.StarBrush}}"
                                    ToolTip.Tip="Favourite (shared with the VR lobby)"
                                    Command="{ReflectionBinding $parent[Window].DataContext.ToggleFavouriteCommand}" CommandParameter="{Binding}" />
                          </Grid>
                          <!-- Medium, small and text-only cards: the badges that sit on the picture on large ones. -->
                          <WrapPanel IsVisible="{ReflectionBinding $parent[Window].DataContext.BadgesInText}">
                            <Border Classes="chip" Margin="0,0,5,4"><TextBlock Text="{Binding EngineBadge}" /></Border>
                            <Border Classes="chip hot" Margin="0,0,5,4" IsVisible="{Binding IsIncomplete}"><TextBlock Text="INCOMPLETE" /></Border>
                            <Border Classes="chip hot" Margin="0,0,5,4" IsVisible="{Binding HasUpdate}"><TextBlock Text="UPDATE" /></Border>
                            <Border Classes="chip hot" Margin="0,0,5,4" IsVisible="{Binding NeedsRom}"><TextBlock Text="NEEDS ROM" /></Border>
                            <Border Classes="chip" Margin="0,0,5,4" IsVisible="{Binding Pup.IsInstalled}" ToolTip.Tip="{Binding Pup.Status}"><TextBlock Text="PUP" /></Border>
                            <Border Classes="chip" Margin="0,0,5,4" IsVisible="{Binding Colour.IsInstalled}" ToolTip.Tip="{Binding Colour.Status}"><TextBlock Text="COLOUR" /></Border>
                            <Border Classes="chip" Margin="0,0,5,4" IsVisible="{Binding Sound.IsInstalled}" ToolTip.Tip="{Binding Sound.Status}"><TextBlock Text="ALTSOUND" /></Border>
                          </WrapPanel>
                          <TextBlock Classes="mono" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="mono" Foreground="{StaticResource Lamp}" Text="{Binding PlayInfo}" TextTrimming="CharacterEllipsis" />
                          <Border Classes="dmd" Padding="8,4" Margin="0,2,0,2" HorizontalAlignment="Left" IsVisible="{Binding HasHighScore}"
                                  ToolTip.Tip="{Binding MoreScores}">
                            <TextBlock Classes="dmd" FontSize="13" Text="{Binding TopScore}" TextTrimming="CharacterEllipsis" />
                          </Border>
                          <Panel IsVisible="{ReflectionBinding $parent[Window].DataContext.ShowCardDetails}">
                            <TextBlock Classes="mono" Text="{Binding DiskInfo}" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding DiskInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </Panel>
                          <TextBlock FontSize="12" Foreground="{StaticResource Orange}" Text="{Binding RomStatus}" TextWrapping="Wrap"
                                     IsVisible="{Binding NeedsRom}" />
                          <Panel IsVisible="{ReflectionBinding $parent[Window].DataContext.ShowCardDetails}">
                            <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{Binding RomUnavailableText}"
                                       IsVisible="{Binding RomUnavailable}" />
                          </Panel>
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding HasUpdate}">
                            <TextBlock FontSize="12" Foreground="{StaticResource Insert}" FontWeight="SemiBold" Text="{Binding UpdateLabel}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="small" Content="UPDATE" Margin="8,0,0,0"
                                    IsEnabled="{Binding !IsBusy}" Command="{ReflectionBinding $parent[Window].DataContext.UpdateTableCommand}" CommandParameter="{Binding}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Addons}" IsVisible="{ReflectionBinding $parent[Window].DataContext.ShowCardDetails}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AddonSlot">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0" IsVisible="{Binding IsInstalled}">
                                  <TextBlock Classes="mono" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                  <Button Grid.Column="1" Classes="small" Content="UPDATE" Margin="8,0,0,0" IsVisible="{Binding HasUpdate}"
                                          ToolTip.Tip="Download the catalog's newer version and replace the installed one"
                                          IsEnabled="{Binding !Item.IsBusy}" Command="{Binding Item.Owner.UpdateAddonCommand}" CommandParameter="{Binding}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock FontSize="12" Foreground="{StaticResource Insert}" TextWrapping="Wrap" IsVisible="{Binding IsIncomplete}"
                                     Text="This install was cut off before it finished, so files may be missing. Reinstall it." />
                        </StackPanel>
                      </DockPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ================= Get tables ================= -->
      <TabItem Header="GET TABLES">
        <Grid ColumnDefinitions="*,Auto">

          <!-- Everything above the cards stays put; only the cards scroll. -->
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="28,14,12,6" Spacing="10">
              <!-- One line: title and source; the match count on a slim score display on the right. -->
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                            ToolTip.Tip="Every VPX and Future Pinball table on the Virtual Pinball Spreadsheet. Pick one, hit Install, and it's downloaded, unpacked and ready to play in your headset. Sign in to the table site once; the app does the clicking after that.">
                  <TextBlock Classes="h2" Text="Get Tables" VerticalAlignment="Center" />
                  <TextBlock Classes="eyebrow" Text="VIRTUAL PINBALL SPREADSHEET · ONE-CLICK INSTALL" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Classes="dmd" Height="40" Margin="16,0,4,0" ClipToBounds="True" VerticalAlignment="Center">
                  <Grid>
                    <Border Background="{StaticResource DmdDots}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Classes="dmd" FontSize="26" VerticalAlignment="Center"
                                 Text="{Binding MatchCount, StringFormat='{}{0:N0}'}" />
                      <TextBlock Classes="dmd" FontSize="13" LetterSpacing="2" VerticalAlignment="Center"
                                 Text="{Binding TotalCount, StringFormat='TABLES MATCH · OF {0:N0}'}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>

              <!-- Search and filters in one row that wraps when the window is narrow -->
              <WrapPanel>
                <WrapPanel.Styles>
                  <Style Selector="ComboBox">
                    <Setter Property="Margin" Value="0,0,10,8" />
                    <Setter Property="MinWidth" Value="150" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </WrapPanel.Styles>
                <TextBox Text="{Binding SearchText}" PlaceholderText="Search name, manufacturer or author" Width="300" Margin="0,0,12,8">
                  <TextBox.InnerLeftContent>
                    <PathIcon Classes="search" Margin="12,0,0,0" />
                  </TextBox.InnerLeftContent>
                </TextBox>
                <ListBox Classes="segmented" Margin="0,0,14,8" VerticalAlignment="Center"
                         ItemsSource="{Binding EngineFilters}" SelectedItem="{Binding EngineFilter}" />
                <ToggleSwitch Margin="0,0,14,8" IsChecked="{Binding VrOnly}" OnContent="VR-ready only" OffContent="VR-ready only"
                              FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding ManufacturerFilter}" MaxDropDownHeight="420" ToolTip.Tip="Manufacturer" />
                <ComboBox ItemsSource="{Binding Eras}" SelectedItem="{Binding EraFilter}" ToolTip.Tip="When the real machine came out" />
                <ComboBox ItemsSource="{Binding MachineTypes}" SelectedItem="{Binding TypeFilter}" ToolTip.Tip="Solid state (1977 on), electro-mechanical, or original designs" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,10,8" VerticalAlignment="Center">
                  <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="SORT" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding CatalogSorts}" SelectedItem="{Binding CatalogSort}" Margin="0" />
                </StackPanel>
                <Button Classes="small" Content="CLEAR FILTERS" Margin="0,0,10,8" VerticalAlignment="Center"
                        IsVisible="{Binding HasCatalogFilters}" Command="{Binding ClearCatalogFiltersCommand}" />
                <Button Classes="icon" Content="⟳" ToolTip.Tip="Refresh catalog" Margin="0,0,12,8"
                        Command="{Binding RefreshCatalogCommand}" VerticalAlignment="Center" />
                <TextBlock Classes="mono" Margin="0,0,4,8" VerticalAlignment="Center" Text="{Binding CountLabel}" />
              </WrapPanel>

              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" Width="120" />
                <TextBlock Classes="mono" Text="Loading tables…" />
              </StackPanel>
            </StackPanel>

          <ScrollViewer>
            <StackPanel Margin="28,8,12,28" Spacing="20">

              <!-- Card grid -->
              <ListBox Classes="grid" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameItem">
                    <Border Classes="tile" Width="214">
                      <StackPanel>
                        <!-- The picture is clipped to the card's inner rounded corners, so it never covers the (highlighted) border. -->
                        <Border Classes="tileArt" Height="276">
                        <Grid>
                          <Border Background="{StaticResource Stripes}" />
                          <TextBlock Classes="mono" Text="NO ARTWORK" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !HasImage}" />
                          <Image v:ImageLoader.Url="{Binding ImgUrl}" Stretch="UniformToFill" />
                          <Border Background="{StaticResource CardFade}" />
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="10" VerticalAlignment="Top">
                            <Border Classes="chip lit" IsVisible="{Binding IsVr}"><TextBlock Text="VR" /></Border>
                            <Border Classes="chip hot" IsVisible="{Binding HasFp}"><TextBlock Text="FP" /></Border>
                          </StackPanel>
                          <Border Classes="chip green" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsVisible="{Binding IsInstalled}">
                            <TextBlock Text="INSTALLED" />
                          </Border>
                        </Grid>
                        </Border>
                        <StackPanel Margin="14,12,14,14" Spacing="3">
                          <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding MakerYear}" />
                          <TextBlock Classes="mono" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                     Text="{Binding AuthorsShort, StringFormat='✎  {0}'}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button HorizontalAlignment="Center" Content="SHOW MORE TABLES" IsVisible="{Binding HasMore}"
                      Command="{Binding ShowMoreCommand}" />
            </StackPanel>
          </ScrollViewer>
          </DockPanel>

          <!-- Detail drawer -->
          <Border Grid.Column="1" Width="470" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                  IsVisible="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer>
              <StackPanel>
                <Grid Height="250">
                  <Border Background="{StaticResource Stripes}" />
                  <Image v:ImageLoader.Url="{Binding SelectedGame.ImgUrl}" Stretch="UniformToFill" />
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.35" Color="#00141416" />
                        <GradientStop Offset="1" Color="#FF141416" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Button Classes="icon" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                          Background="#B30A0A0B" Command="{Binding CloseDetailsCommand}" />
                </Grid>

                <StackPanel Margin="24,0,24,28" Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h2" FontSize="22" Text="{Binding SelectedGame.Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="13.5" Text="{Binding SelectedGame.MakerYear}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                      <Border Classes="chip lit" IsVisible="{Binding SelectedGame.IsVr}"><TextBlock Text="VR READY" /></Border>
                      <Border Classes="chip hot" IsVisible="{Binding SelectedGame.HasFp}"><TextBlock Text="FUTURE PINBALL" /></Border>
                      <Border Classes="chip green" IsVisible="{Binding SelectedGame.IsInstalled}"><TextBlock Text="INSTALLED" /></Border>
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="eyebrow" Text="VERSIONS" Margin="0,6,0,0" />

                  <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TableVersionItem">
                        <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border Classes="chip lit" IsVisible="{Binding IsVr}"><TextBlock Text="VR" /></Border>
                              <Border Classes="chip"><TextBlock Text="{Binding Engine}" /></Border>
                            </StackPanel>
                            <TextBlock Classes="title" Text="{Binding Heading}" TextWrapping="Wrap" />
                            <TextBlock Classes="mono" Text="{Binding Details}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FeatureList}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="chip quiet" Margin="0,0,5,5"><TextBlock Text="{Binding}" /></Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" Text="{Binding Comment}" TextWrapping="Wrap" FontStyle="Italic"
                                       IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                              <Button Classes="primary" Content="INSTALL" Command="{Binding Install}" IsEnabled="{Binding HasUrl}" />
                              <Button Content="OPEN PAGE" IsEnabled="{Binding HasUrl}"
                                      Command="{ReflectionBinding $parent[Window].DataContext.OpenPageCommand}"
                                      CommandParameter="{Binding Url}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

        </Grid>
      </TabItem>

      <!-- ================= Setup ================= -->
      <!-- A rail of sections on the left, one section at a time on the right: Setup had grown into one long
           scroll. VPX and its folders come first, because nothing else works without them. -->
      <TabItem Header="SETUP">
        <Grid ColumnDefinitions="256,*">
          <!-- Section rail -->
          <Border Background="#0E0E10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer>
              <StackPanel Margin="16,22,14,22" Spacing="3">
                <StackPanel Spacing="2" Margin="6,0,0,10">
                  <TextBlock Classes="eyebrow" Text="GET YOUR QUEST 3 READY" FontSize="12" />
                  <TextBlock Classes="display" FontSize="40" Text="Setup" />
                </StackPanel>

                <TextBlock Classes="railGroup" Text="PINBALL" />
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=vpx}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="01" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Visual Pinball X" />
                      <TextBlock Classes="navSub" Text="Install, builds, folders" />
                    </StackPanel>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=play}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="02" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Playing tables" />
                      <TextBlock Classes="navSub" Text="PinMAME, PuP, backglass" />
                    </StackPanel>
                  </Grid>
                </RadioButton>

                <TextBlock Classes="railGroup" Text="VIRTUAL REALITY" />
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=headset}">
                  <Grid ColumnDefinitions="30,*,Auto">
                    <TextBlock Classes="navNum" Text="03" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Headset" />
                      <TextBlock Classes="navSub" Text="Runtime, smoothness, controls" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip hot" Padding="7,1" VerticalAlignment="Center" IsVisible="{Binding IsRuntimeWarning}"
                            ToolTip.Tip="Check the OpenXR runtime">
                      <TextBlock Text="!" />
                    </Border>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=fit}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="04" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Fit &amp; position" />
                      <TextBlock Classes="navSub" Text="Lockbar height, table size" />
                    </StackPanel>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=graphics}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="05" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="VR graphics" />
                      <TextBlock Classes="navSub" Text="VPX's quality in the headset" />
                    </StackPanel>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=lobby}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="06" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="VR lobby" />
                      <TextBlock Classes="navSub" Text="Cabinets, loading, music" />
                    </StackPanel>
                  </Grid>
                </RadioButton>

                <TextBlock Classes="railGroup" Text="TABLES" />
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=downloads}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="07" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Downloads" />
                      <TextBlock Classes="navSub" Text="Table sites, the queue" />
                    </StackPanel>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=games}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="08" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Other games" />
                      <TextBlock Classes="navSub" Text="Future Pinball, Pinball FX &amp; M" />
                    </StackPanel>
                  </Grid>
                </RadioButton>

                <TextBlock Classes="railGroup" Text="THIS APP" />
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=updates}">
                  <Grid ColumnDefinitions="30,*,Auto">
                    <TextBlock Classes="navNum" Text="09" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Updates" />
                      <TextBlock Classes="navSub" Text="App, tables, add-ons, VPX" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip hot" Padding="7,1" VerticalAlignment="Center"
                            IsVisible="{Binding UpdateCount, Converter={x:Static v:Converters.NonZero}}">
                      <TextBlock Text="{Binding UpdateCount}" />
                    </Border>
                  </Grid>
                </RadioButton>
                <RadioButton Classes="setupNav" GroupName="setupNav"
                             IsChecked="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=maintenance}">
                  <Grid ColumnDefinitions="30,*">
                    <TextBlock Classes="navNum" Text="10" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="navTitle" Text="Maintenance" />
                      <TextBlock Classes="navSub" Text="Logs, storage, backup" />
                    </StackPanel>
                  </Grid>
                </RadioButton>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Sections: only the one picked in the rail shows; each scrolls on its own. -->
          <Panel Grid.Column="1">

            <!-- 01 Visual Pinball X -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=vpx}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="01 · PINBALL" />
                    <TextBlock Classes="display" FontSize="42" Text="Visual Pinball X" />
                    <TextBlock Classes="body" Text="VPX, your headset (03) and a table site (07) are all you need. Future Pinball, Pinball FX and Pinball M are optional extras, under Other games." />
                  </StackPanel>

                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Install &amp; update" />
                      <TextBlock Classes="body" Foreground="{StaticResource Text}" Text="{Binding VpxStatus}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="INSTALL / UPDATE VPX" Command="{Binding InstallVpxCommand}" IsEnabled="{Binding !IsInstallingVpx}" />
                        <Button Content="CHECK FOR UPDATES" Command="{Binding CheckVpxUpdateCommand}" />
                        <Button Content="CHOOSE A BUILD…" Command="{Binding LoadVpxBuildsCommand}" IsEnabled="{Binding !IsInstallingVpx}"
                                ToolTip.Tip="Lists VPX's releases (and, with nightly builds on, the last week or so of nightlies) so you can install a particular one, such as an older build when a newer one broke something." />
                      </StackPanel>
                      <WrapPanel IsVisible="{Binding HasVpxBuilds}">
                        <ComboBox ItemsSource="{Binding VpxBuilds}" SelectedItem="{Binding ChosenVpxBuild}" MinWidth="380" MaxDropDownHeight="420"
                                  Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button Classes="small" Content="{Binding ChosenVpxButtonText}" Command="{Binding InstallChosenVpxCommand}" IsEnabled="{Binding !IsInstallingVpx}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Installs the picked build over the one you have, older or newer, and keeps it: newer builds aren't offered as updates until you click INSTALL / UPDATE VPX. Your settings files stay as they are. On the installed build it reinstalls it, which repairs a damaged VPX folder." />
                      </WrapPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsInstallingVpx}">
                        <ProgressBar Value="{Binding VpxProgress}" IsIndeterminate="{Binding VpxProgressUnknown}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="CANCEL" Command="{Binding CancelVpxInstallCommand}" />
                      </Grid>
                      <TextBlock Classes="mono" Text="{Binding LatestVpx}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Installs the official BGFX build from github.com/vpinball (VR through OpenXR)." />
                      <TextBlock Classes="eyebrow" Text="BUILDS" Margin="0,6,0,0" />
                      <CheckBox IsChecked="{Binding VpxUseDoNotUseBuilds}"
                                Content="Use the BGFX builds marked &quot;DO NOT USE&quot; on GitHub (recommended)"
                                ToolTip.Tip="The VPX team labels its current BGFX builds &quot;DO NOT USE&quot;; they have the newest VR work. Off: only builds without that label are installed or offered as updates (plus nightlies, if that option is on). Click CHECK FOR UPDATES after changing this." />
                      <CheckBox IsChecked="{Binding VpxUseNightlyBuilds}"
                                Content="Use nightly BGFX builds (newest, untested)"
                                ToolTip.Tip="VPX builds every change to its master branch. On: the newest of those builds is installed and offered as an update when it's newer than the newest release. They're downloaded through nightly.link (GitHub only gives them to signed-in users) and nobody has tested them, so one can break tables. Works with or without the &quot;DO NOT USE&quot; builds option above, which only decides whether those releases are offered too (some work better than the newest nightly). Off: only releases. Turning it off keeps the nightly you have until a newer release comes out. Click CHECK FOR UPDATES after changing this." />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Folders" />
                      <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="VPX INSTALL FOLDER" />
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding VpxDir}" />
                        <Button Grid.Column="1" Content="BROWSE" Margin="8,0,0,0" Command="{Binding BrowseVpxDirCommand}" />
                        <Button Grid.Column="2" Content="OPEN" Margin="8,0,0,0" Command="{Binding OpenVpxFolderCommand}" />
                      </Grid>
                      <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="VPX TABLES FOLDER · ONE SUB-FOLDER PER TABLE" Margin="0,6,0,0" />
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding TablesDir}" />
                        <Button Grid.Column="1" Content="BROWSE" Margin="8,0,0,0" Command="{Binding BrowseTablesDirCommand}" />
                        <Button Grid.Column="2" Content="OPEN" Margin="8,0,0,0" Command="{Binding OpenTablesFolderCommand}" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="small" Content="COPY TABLES FROM ANOTHER VPX INSTALL…" Command="{Binding ImportTablesCommand}"
                                ToolTip.Tip="Pick another VPX folder (or its Tables folder). Its tables are copied here, one folder each, with their ROMs, NVRAM, AltSound, AltColor and PuP packs from that install's VPinMAME and PinUPSystem folders. Tables already here are skipped; the other install isn't changed." />
                        <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ImportStatus}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="VPX settings, in layers" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Tables play with your own VPX settings (VPinballX.ini, which you can keep changing in VPX or by hand), with the manager's VR or desktop changes on top. A setting in the VR or desktop file wins over yours for that mode only; leave its value empty to use yours. Settings you change in VPX's menu while playing a table from here are kept in that mode's file. Your VPinballX.ini is never changed by the manager. Edit the files while no table is running." />
                      <WrapPanel>
                        <Button Classes="small" Content="EDIT MY VPINBALLX.INI" Margin="0,0,8,8" Command="{Binding OpenOwnVpxIniCommand}"
                                ToolTip.Tip="Your own VPX settings: used for VR and desktop play, except where the VR or desktop file says otherwise." />
                        <Button Classes="small" Content="EDIT VR SETTINGS" Margin="0,0,8,8" Command="{Binding OpenVrIniCommand}"
                                ToolTip.Tip="VrTableManager-VR.ini beside VPX: settings for VR play only, on top of yours." />
                        <Button Classes="small" Content="EDIT DESKTOP SETTINGS" Margin="0,0,8,8" Command="{Binding OpenDesktopIniCommand}"
                                ToolTip.Tip="VrTableManager-Desktop.ini beside VPX: settings for DESKTOP play only, on top of yours." />
                      </WrapPanel>
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" Text="{Binding SettingsFilesStatus}" TextWrapping="Wrap"
                                 IsVisible="{Binding SettingsFilesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: PLAYING TABLES  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="play" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 02 Playing tables -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=play}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="02 · PINBALL" />
                    <TextBlock Classes="display" FontSize="42" Text="Playing tables" />
                    <TextBlock Classes="body" Text="What VPX turns on for every table you start from here, in VR and on the desktop." />
                  </StackPanel>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="ROMs, displays &amp; backglass" />
                      <CheckBox IsChecked="{Binding UseBuiltInPinmame}"
                                Content="Use VPX's built-in PinMAME (recommended)"
                                ToolTip.Tip="In VR and desktop play, reads each table's ROMs, scores, ROM aliases and Serum colours from its own folder. Off: VPX uses a separately installed VPinMAME and its own roms folder." />
                      <CheckBox IsChecked="{Binding UsePupPlugin}"
                                Content="Show PuP packs (VPX's PinUP Player plugin)"
                                ToolTip.Tip="Plays a table's PuP pack (pupvideos in its folder) on the cabinet's backglass and DMD. Tables without one are unaffected." />
                      <CheckBox IsChecked="{Binding UseDisplayPlugins}"
                                Content="Use VPX's FlexDMD and backglass (B2S) plugins (recommended)"
                                ToolTip.Tip="FlexDMD draws the DMD for tables whose script makes it (many originals, such as Jaws and Mass Effect). B2S shows a table's .directb2s backglass." />
                      <CheckBox IsChecked="{Binding VrAutoBackglass}"
                                Content="Add a backglass in VR to desktop tables, not VR tables (needed for PuP packs)"
                                ToolTip.Tip="Desktop and cabinet tables have no backglass in the VR scene, so their PuP pack or .directb2s plays with nothing to show it: they get VPX's default backglass display. VR tables have their own and don't. Off: VPX's own Add Backglass setting decides. A table setting saved in VPX always wins." />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="While you play" />
                      <CheckBox IsChecked="{Binding DesktopBloomOff}"
                                Content="Turn off VPX's bloom (the glow around bright lights) in desktop play"
                                ToolTip.Tip="Sets VPX's Force Bloom Off for every desktop launch: a little faster on slow graphics cards, and lights look crisper. Off: VPX's own setting decides. VR play has its own Bloom setting under VPX GRAPHICS IN VR." />
                      <CheckBox IsChecked="{Binding AutoVrRoom}"
                                Content="Turn on a table's VR room for VR play, and off for desktop play (recommended)"
                                ToolTip.Tip="Some tables have a VR room switch at the top of their script (VRRoom = 0) instead of noticing VR themselves, so in the headset they play with no cabinet and often too dark (The Getaway, Batman 66, Monster Bash). Play in VR turns it on and DESKTOP turns it off, using a copy of the script beside the table; the .vpx isn't changed. Off: tables play as they came." />
                      <CheckBox Content="Hide this window while playing and bring it back when the table closes" IsChecked="{Binding ReturnAfterPlay}" />
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: HEADSET  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="headset" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 03 Headset -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=headset}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="03 · VIRTUAL REALITY" />
                    <TextBlock Classes="display" FontSize="42" Text="Headset" />
                    <TextBlock Classes="body"
                               Text="VPX talks to your headset through the PC's OpenXR runtime. Easiest: install the Meta Quest Link app, connect with a USB-C cable or Air Link, and make Meta Quest Link the active OpenXR runtime (Link app → Settings → General). Virtual Desktop (VDXR) and SteamVR also work." />
                  </StackPanel>

                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h2" Text="OpenXR runtime" VerticalAlignment="Center" />
                        <Border Classes="chip hot" VerticalAlignment="Center" IsVisible="{Binding IsRuntimeWarning}"><TextBlock Text="CHECK THIS" /></Border>
                      </StackPanel>
                      <TextBlock Classes="title" Text="{Binding RuntimeTitle}" />
                      <TextBlock Classes="body" Text="{Binding RuntimeAdvice}" />
                      <ItemsControl ItemsSource="{Binding Runtimes}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="services:OpenXrRuntime">
                            <Panel Margin="0,0,8,8">
                              <Border Classes="chip green" Padding="10,6" IsVisible="{Binding IsActive}">
                                <TextBlock Text="{Binding Name, StringFormat='● {0} (ACTIVE)'}" />
                              </Border>
                              <Button Classes="small" IsVisible="{Binding !IsActive}"
                                      Content="{Binding Name, StringFormat='USE {0}'}"
                                      Command="{ReflectionBinding $parent[Window].DataContext.MakeRuntimeActiveCommand}" CommandParameter="{Binding}" />
                            </Panel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <CheckBox Content="Warn me before a VR launch when SteamVR is the active runtime" IsChecked="{Binding WarnSteamVrRuntime}" />
                      <WrapPanel>
                        <Button Classes="small" Content="OPEN META QUEST LINK" Margin="0,0,8,8" IsVisible="{Binding HasMetaLinkApp}" Command="{Binding OpenMetaLinkAppCommand}" />
                        <Button Classes="small" Content="RECHECK" Margin="0,0,8,8" Command="{Binding RecheckSetupCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Smoothness" />
                      <Grid ColumnDefinitions="210,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Headset refresh rate" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding RefreshRate}" Width="190" />
                        <TextBlock Grid.Column="2" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Pick the highest rate your PC holds without drops. 90 Hz is a good start; 72 Hz gives a slower PC more time per frame." />
                        <TextBlock Grid.Row="1" Text="Spacewarp (ASW, Quest Link)" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AswModes}" SelectedItem="{Binding AswMode}" Width="190" VerticalAlignment="Center"
                                  IsEnabled="{Binding IsAswAvailable}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="When a frame is late, ASW shows a guessed one, which smears a fast ball. Off is usually better for pinball if your PC keeps up. Applied before each VR launch through the Oculus Debug Tool (it resets when the Oculus service restarts)." />
                      </Grid>
                      <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsAswAvailable}"
                                 Text="ASW can only be set when the Meta Quest Link app is installed. Virtual Desktop and SteamVR have their own setting (Synchronous Spacewarp / Motion Smoothing)." />
                      <WrapPanel IsVisible="{Binding HasOculusDebugTool}">
                        <Button Classes="small" Content="OPEN OCULUS DEBUG TOOL" Margin="0,0,8,0" Command="{Binding OpenOculusDebugToolCommand}"
                                ToolTip.Tip="Encode bitrate, resolution and more for Quest Link" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="h2" Text="Controls" />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="VR play has its own VPX settings file, so controls mapped in desktop VPX aren't there until they're copied. They're copied automatically the first time; after that, remaps you make in VR (in-game menu → Input) stay for every table." />
                      <WrapPanel>
                        <Button Classes="small" Content="USE MY DESKTOP VPX CONTROLS" Margin="0,0,8,0" Command="{Binding ImportDesktopControlsCommand}"
                                ToolTip.Tip="Copies the [Input] section of your VPinballX.ini into the VR settings file, keeping the VR controller buttons." />
                      </WrapPanel>
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" TextWrapping="Wrap" Text="{Binding ControlsStatus}"
                                 IsVisible="{Binding ControlsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: FIT &amp; POSITION  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="fit" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 04 Fit & position -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=fit}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="04 · VIRTUAL REALITY" />
                    <TextBlock Classes="display" FontSize="42" Text="Fit &amp; position" />
                    <TextBlock Classes="body" Text="How high and how far away every VPX table stands in the headset, and how big it is." />
                  </StackPanel>

                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Fit VR to me" />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="Every VPX table gets its lockbar at the same height and distance from you, sized like a real machine, so you don't line each one up yourself. Tables use a real cabinet's values until you change them. Changes here count once you click FIT EVERY TABLE TO ME, and then for every table." />
                      <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Text="Your height" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Grid Grid.Column="1" Width="210" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                          <Button Classes="small" Content="−" Command="{Binding FitHeightLessCommand}" ToolTip.Tip="Shorter" />
                          <TextBox Grid.Column="1" Text="{Binding FitHeightText}" PlaceholderText="optional" HorizontalContentAlignment="Center" MinWidth="0" />
                          <Button Grid.Column="2" Classes="small" Content="+" Command="{Binding FitHeightMoreCommand}" ToolTip.Tip="Taller" />
                          <Button Grid.Column="3" Classes="small" Content="×" Command="{Binding FitHeightClearCommand}" ToolTip.Tip="Clear (your height is optional)" />
                        </Grid>
                        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Optional: fills in the lockbar height below, and × clears it. − and + move 1 cm (1&quot;). The headset already knows how tall you are." />

                        <TextBlock Grid.Row="1" Text="Lockbar height" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Grid.Column="1" Width="210" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                          <Button Classes="small" Content="−" Command="{Binding FitLockbarLowerCommand}" ToolTip.Tip="Lower" />
                          <TextBox Grid.Column="1" Text="{Binding FitLockbarText}" HorizontalContentAlignment="Center" MinWidth="0" />
                          <Button Grid.Column="2" Classes="small" Content="+" Command="{Binding FitLockbarHigherCommand}" ToolTip.Tip="Higher" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Floor to the top of the lockbar. A real cabinet's is about 91 cm (36&quot;). On a real cabinet or a controller stand, measure yours. − and + move 1 cm (1&quot;)." />

                        <TextBlock Grid.Row="2" Text="Eyes behind it" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Grid Grid.Row="2" Grid.Column="1" Width="210" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                          <Button Classes="small" Content="−" Command="{Binding FitEyesCloserCommand}" ToolTip.Tip="Closer to the table" />
                          <TextBox Grid.Column="1" Text="{Binding FitEyesText}" HorizontalContentAlignment="Center" MinWidth="0" />
                          <Button Grid.Column="2" Classes="small" Content="+" Command="{Binding FitEyesFurtherCommand}" ToolTip.Tip="Further back" />
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="How far your eyes are behind the lockbar: − and + move 1 cm (1&quot; in feet and inches), or type it. About 10 cm (4&quot;) feels like standing at a real cabinet. It's exact once you recenter (keypad 5) where you stand; a negative number leans you over the glass." />

                        <TextBlock Grid.Row="3" Text="Table size" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding FitSizes}" SelectedIndex="{Binding FitSizeIndex}"
                                  MinWidth="300" HorizontalAlignment="Left"
                                  ToolTip.Tip="VPX scales every table so its lockbar is 70 cm wide, which makes a standard table about a fifth too big. Real size works out each table's own width from its playfield every time it starts, so a width you change in VPX's menu lasts only until that table closes. The same width suits a controller stand: the table always fits it." />

                        <TextBlock Grid.Row="4" Text="Lockbar width" VerticalAlignment="Center" FontWeight="SemiBold" IsVisible="{Binding IsFitSameWidth}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FitSameWidthText}" Width="150" IsVisible="{Binding IsFitSameWidth}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsFitSameWidth}"
                                   Text="A standard (WPC) table's is 57 cm (22½&quot;); a widebody's about 65 cm." />
                      </Grid>
                      <CheckBox IsChecked="{Binding FitUseInches}" Content="Feet and inches" />
                      <CheckBox IsChecked="{Binding FitResetPosition}" Content="Also put the table straight ahead, where the headset centres you"
                                ToolTip.Tip="Forgets the position you set in the headset. The table then starts in front of the headset's centre point (hold the Meta button to move that to where you stand). Off: only the height offset is cleared, so the lockbar height above is what you get." />
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding FitSummary}" />
                      <WrapPanel>
                        <Button Classes="small" Content="FIT EVERY TABLE TO ME" Margin="0,0,8,0" Command="{Binding ApplyVrFitCommand}"
                                ToolTip.Tip="Saves these in the VR settings file. Changes here only count once you click this. Desktop play doesn't change." />
                        <Button Classes="small" Content="RESET TO DEFAULTS" Margin="0,0,8,0" Command="{Binding ResetVrFitCommand}"
                                ToolTip.Tip="A real cabinet's lockbar height, your eyes 10 cm (4&quot;) behind it, every table at its real size, and the table straight ahead." />
                      </WrapPanel>
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" TextWrapping="Wrap" Text="{Binding FitStatus}"
                                 IsVisible="{Binding FitStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="h2" Text="Where the table sits in VR" />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="Line the table up while playing, in the headset. VPX remembers it for every table." />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="• Click the LEFT THUMBSTICK to line the table up with your VR controllers: hold them where you want the front of the cabinet (the lockbar) and click. Do this standing where you play. Until the table closes, this also takes the lockbar height and width from your controllers, in place of FIT VR TO ME's." />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="• Or press X on the left controller for VPX's menu: its VR settings move the table forward, back, up and down, turn it, and set the lockbar width (the table's size)." />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="• At the keyboard: keypad 5 recenters, keypad 8 and 2 raise and lower the table. The headset's own recenter (hold the Meta button) moves the room with you." />
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="• Where you stand is kept for every table. A height you set (keypad 8 and 2, or VPX's menu) is kept for that table only, because tables sit differently when their authors set different glass heights. The table's card shows it and can clear it. For every table's height, change the lockbar height above." />
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding VrViewText}" />
                      <WrapPanel>
                        <Button Classes="small" Content="RESET TABLE POSITION" Margin="0,0,8,0" Command="{Binding ResetVrViewCommand}"
                                ToolTip.Tip="Forgets the position set in the headset, so VPX places the table itself again." />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: VR GRAPHICS  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="graphics" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 05 VR graphics -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=graphics}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="05 · VIRTUAL REALITY" />
                    <TextBlock Classes="display" FontSize="42" Text="VR graphics" />
                    <TextBlock Classes="body"
                               Text="Pinball needs a steady frame rate more than anything: the ball moves fast, so one late frame shows as a skip. Start with Performance, then raise things while it stays smooth." />
                  </StackPanel>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="h2" Text="VPX graphics in VR" />
                          <TextBlock Classes="mono" Text="{Binding GraphicsPresetLabel}" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding GraphicsPresets}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Button Classes="small" Content="{Binding}"
                                      Command="{ReflectionBinding $parent[Window].DataContext.ApplyGraphicsPresetCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                      <Grid ColumnDefinitions="210,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                          <Style Selector="Grid > TextBlock.k">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,5" />
                          </Style>
                          <Style Selector="Grid > ComboBox">
                            <Setter Property="Width" Value="210" />
                            <Setter Property="Margin" Value="0,5" />
                          </Style>
                          <Style Selector="Grid > TextBlock.muted">
                            <Setter Property="Margin" Value="12,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                          </Style>
                        </Grid.Styles>
                        <TextBlock Classes="k" Text="Render scale" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RenderScales}" SelectedItem="{Binding GfxRenderScale}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="Biggest effect on speed and sharpness. 100% = the headset's own resolution. Heavy tables can have their own (My Tables → More)." />

                        <TextBlock Grid.Row="1" Classes="k" Text="Anti-aliasing (MSAA)" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MsaaNames}" SelectedIndex="{Binding GfxMsaa}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="Smooths edges of ramps and rails. 4× is plenty; costs GPU time and memory." />

                        <TextBlock Grid.Row="2" Classes="k" Text="Post-process AA" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PostAaNames}" SelectedIndex="{Binding GfxPostAa}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted" Text="Cheap edge smoothing when MSAA is off. Fast FXAA costs almost nothing." />

                        <TextBlock Grid.Row="3" Classes="k" Text="Reflections" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ReflectionNames}" SelectedIndex="{Binding GfxReflections}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Classes="muted" Text="Playfield reflections. Dynamic looks best but costs the most in VR (everything is drawn twice)." />

                        <TextBlock Grid.Row="4" Classes="k" Text="Ambient occlusion" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AoNames}" SelectedIndex="{Binding GfxAo}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="muted" Text="Soft shadows in corners. Static is nearly free; Dynamic follows moving parts." />

                        <TextBlock Grid.Row="5" Classes="k" Text="Sharpening" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SharpenNames}" SelectedIndex="{Binding GfxSharpen}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Classes="muted" Text="CAS sharpens text and art, useful below 100% render scale or over Wi-Fi." />

                        <TextBlock Grid.Row="6" Classes="k" Text="Bloom" />
                        <CheckBox Grid.Row="6" Grid.Column="1" Content="Glow around lit inserts" IsChecked="{Binding GfxBloom}" Margin="0,5" />

                        <TextBlock Grid.Row="7" Classes="k" Text="Frame rate overlay" />
                        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding FpsNames}" SelectedIndex="{Binding GfxFps}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Classes="muted" Text="Shows VPX's frame rate in the headset while you tune. (F11 toggles it in a game.)" />
                      </Grid>
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" Text="{Binding GraphicsStatus}"
                                 IsVisible="{Binding GraphicsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Saved in the VR settings file, on top of your own VPinballX.ini, so desktop play keeps its own settings. A table's own .ini can still override these." />
                      <WrapPanel>
                        <Button Classes="small" Content="OPEN VR SETTINGS FILE" Margin="0,0,8,0" Command="{Binding OpenVrIniCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: VR LOBBY  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="lobby" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 06 VR lobby -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=lobby}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="06 · VIRTUAL REALITY" />
                    <TextBlock Classes="display" FontSize="42" Text="VR lobby" />
                    <TextBlock Classes="body" Text="Your tables as pinball cabinets standing round you in an arcade, started with LAUNCH VR LOBBY on My Tables. Pick one in the headset and it plays." />
                  </StackPanel>

                  <!-- How big the cabinets are and how many stand in the ring (LobbyLayout); the lobby reads them when it starts. -->
                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Cabinets" />
                      <Grid ColumnDefinitions="210,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <TextBlock Text="Cabinet size" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LobbyCabinetScales}" SelectedItem="{Binding LobbyCabinetScale}" Width="150">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                              <TextBlock Text="{Binding StringFormat='{}{0} %'}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="100 % is a real machine. Smaller cabinets leave more room round you; bigger ones keep the same gap between them, so the ring moves back." />

                        <TextBlock Grid.Row="1" Text="Cabinets in the ring" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LobbyCabinetCounts}" SelectedItem="{Binding LobbyCabinetCount}" Width="150" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="The one you've picked and as many either side. More than 11 stand closer together round a bigger ring, and each one costs the headset a little frame rate." />
                      </Grid>
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding LobbyRingSummary}" />
                      <WrapPanel>
                        <Button Classes="small" Content="RESET TO DEFAULTS" Margin="0,0,8,0" Command="{Binding ResetLobbyCabinetsCommand}"
                                ToolTip.Tip="Real-size cabinets, 11 in the ring: the lobby as it always was." />
                      </WrapPanel>
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="The lobby reads these when it starts: one already open, or waiting hidden behind a table, keeps its ring until you quit it." />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Starting tables" />
                      <CheckBox IsChecked="{Binding LobbyWaitsForTable}"
                                Content="Show a loading screen in the VR lobby while a table starts"
                                ToolTip.Tip="The lobby stays in the headset until the table takes it over, and says so if the table fails to start. Turn it off if tables won't open in VR while the lobby is waiting (some OpenXR runtimes allow only one VR app at a time)." />
                      <CheckBox IsChecked="{Binding LobbyStaysOpen}" IsEnabled="{Binding LobbyWaitsForTable}"
                                Content="Keep the VR lobby open behind the table, for a quick return"
                                ToolTip.Tip="The lobby waits, hidden, while you play, and is back the moment the table closes instead of starting up again. It keeps its cabinets in memory meanwhile. Turn it off if a big table runs short of graphics memory." />
                      <CheckBox IsChecked="{Binding LobbyLoadingVideos}" IsEnabled="{Binding LobbyWaitsForTable}"
                                Content="Play a loading video on the loading screen"
                                ToolTip.Tip="A big screen shows the table's loading video, with its sound, until the table takes the headset over. A table gets its own from MORE (media pack, or your own video); the one below plays for the rest." />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Loading video for every table without its own:" />
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding DefaultLoadingVideoText}" />
                      <WrapPanel>
                        <Button Classes="small" Content="CHOOSE A VIDEO…" Margin="0,0,8,0" Command="{Binding ChooseDefaultLoadingVideoCommand}"
                                ToolTip.Tip="Any video file (.mp4 works best), such as one of the generic loading videos front-end users share. The first 30 seconds are used, with their sound." />
                        <Button Classes="small" Content="REMOVE" IsVisible="{Binding HasDefaultLoadingVideo}" Command="{Binding RemoveDefaultLoadingVideoCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Music" />
                      <CheckBox IsChecked="{Binding LobbyRecordsRomAudio}"
                                Content="Record a table's music from its ROM in the VR lobby"
                                ToolTip.Tip="Runs the ROM for about 50 s in the background the first time you stop on a table. Off: only audio files already there play." />
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: DOWNLOADS  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="downloads" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 07 Downloads -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=downloads}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="07 · TABLES" />
                    <TextBlock Classes="display" FontSize="42" Text="Downloads" />
                    <TextBlock Classes="body" Text="Where tables come from, and what happens to the files once they're installed." />
                  </StackPanel>

                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Downloading from table sites" />
                      <TextBlock Classes="body"
                                 Text="Table sites are run by the community and paid for by their ads, and their terms ask that you download yourself. So when you install a table, its page opens in your own browser: sign in if asked, accept the site's terms, and click Download. The app picks the file up from your Downloads folder and does everything else (unpacking, ROMs, add-ons, layout). Your password goes only to the site, never to this app." />
                      <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding DownloadsFolderText}" />
                      <WrapPanel>
                        <Button Content="VPUNIVERSE" Margin="0,0,8,8" Command="{Binding OpenSiteCommand}" CommandParameter="https://vpuniverse.com/login/" />
                        <Button Content="VPFORUMS" Margin="0,0,8,8" Command="{Binding OpenSiteCommand}" CommandParameter="https://www.vpforums.org/index.php?app=core&amp;module=global&amp;section=login" />
                        <Button Content="PINBALL NIRVANA" Margin="0,0,8,8" Command="{Binding OpenSiteCommand}" CommandParameter="https://pinballnirvana.com/forums/login/" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Queue &amp; catalog" />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Downloads at once" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ParallelDownloadChoices}" SelectedItem="{Binding MaxParallelDownloads}" Width="90" />
                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="More installs wait in the queue. Unpacking doesn't count, so the next download starts meanwhile." />
                      </StackPanel>
                      <CheckBox Content="Delete downloaded files after installing (tables, ROMs, add-ons, media). Files from a failed install are kept."
                                IsChecked="{Binding DeleteDownloadsAfterInstall}" />
                      <CheckBox Content="Hide adult-themed tables" IsChecked="{Binding HideAdult}" />
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: OTHER GAMES  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="games" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 08 Other games -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=games}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="08 · TABLES" />
                    <TextBlock Classes="display" FontSize="42" Text="Other games" />
                    <TextBlock Classes="body" Text="Optional: Future Pinball through BAM, and Zen's Pinball FX and Pinball M through UEVR. VPX doesn't need either." />
                  </StackPanel>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h2" Text="Future Pinball" />
                        <Border Classes="chip quiet" VerticalAlignment="Center"><TextBlock Text="Optional" /></Border>
                      </StackPanel>
                      <TextBlock Classes="body" Foreground="{StaticResource Text}" Text="{Binding FpStatus}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Future Pinball plays in VR through BAM-OpenVR, which needs SteamVR (with Quest Link or Virtual Desktop under it). Install Future Pinball and BAM yourself (see ravarcade.pl), then point this app at the folder." />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding FpDir}" PlaceholderText="C:\Games\Future Pinball" />
                        <Button Grid.Column="1" Content="BROWSE" Margin="8,0,0,0" Command="{Binding BrowseFpDirCommand}" />
                      </Grid>
                      <CheckBox Content="Run FPLoader as administrator (BAM recommends this)" IsChecked="{Binding FpRunAsAdmin}" />
                      <WrapPanel>
                        <Button Classes="small" Content="BAM DOWNLOAD PAGE" Margin="0,0,8,8" Command="{Binding OpenPageCommand}" CommandParameter="https://www.ravarcade.pl/" />
                        <Button Classes="small" Content="BAM OPENVR GUIDE" Margin="0,0,8,8" Command="{Binding OpenPageCommand}" CommandParameter="https://pinballnirvana.com/forums/threads/bam-openvr-guide-by-terryred.19916/" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h2" Text="Pinball FX &amp; Pinball M through UEVR" />
                        <Border Classes="chip quiet" VerticalAlignment="Center"><TextBlock Text="Optional" /></Border>
                      </StackPanel>
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="UEVR injects VR into Zen's Unreal pinball games: Pinball FX and Pinball M (now sold as Pinball FX Midnight). Both are found automatically on Steam or Epic. Play in VR starts the injector, launches the game and closes the injector when you quit. Pick your table inside the game; neither can be told to open one. Choose OpenXR in the injector window (players report it's smoother than OpenVR), and play with a gamepad." />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding UevrDir}" PlaceholderText="Folder containing UEVRInjector.exe" />
                        <Button Grid.Column="1" Content="BROWSE" Margin="8,0,0,0" Command="{Binding BrowseUevrDirCommand}" />
                      </Grid>

                      <!-- Pinball tuning on top of UEVR -->
                      <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="eyebrow" Text="PINBALL SETTINGS FOR UEVR" VerticalAlignment="Center" />
                            <Border Classes="chip green" VerticalAlignment="Center" IsVisible="{Binding ApplyPinballUevrProfile}"><TextBlock Text="ON" /></Border>
                          </StackPanel>
                          <CheckBox Content="Apply pinball settings to UEVR before each VR launch (recommended)" IsChecked="{Binding ApplyPinballUevrProfile}" />
                          <CheckBox Content="Show the 'before you start' checklist before launching" IsChecked="{Binding ShowZenReminder}" />
                          <Expander Header="What gets set, and why" Padding="0,8,0,0">
                            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" LineHeight="19" Text="{Binding PinballProfileSummary}" />
                          </Expander>
                          <TextBlock Classes="muted" TextWrapping="Wrap"
                                     Text="Only these settings are changed; the rest of UEVR's profile is left alone. Your original profile is backed up the first time. OpenXR vs OpenVR can't be set here: UEVR's injector window decides that each time, so the app checks which one was used." />
                        </StackPanel>
                      </Border>

                      <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="PINBALL FX" Margin="0,6,0,0" />
                      <TextBlock Classes="body" Foreground="{StaticResource Text}" Text="{Binding PfxStatus}" />
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" Text="{Binding PfxProfileStatus}" />
                      <WrapPanel>
                        <Button Classes="small" Content="RESET TO PINBALL DEFAULTS" Margin="0,0,8,8" Command="{Binding ApplyPinballProfileCommand}" CommandParameter="PFX" />
                        <Button Classes="small" Content="RESTORE MY ORIGINAL" Margin="0,0,8,8" IsVisible="{Binding PfxHasUevrBackup}" Command="{Binding RestoreUevrOriginalCommand}" CommandParameter="PFX" />
                        <Button Classes="small" Content="IMPORT PROFILE" Margin="0,0,8,8" Command="{Binding ImportUevrProfileCommand}" CommandParameter="PFX" />
                        <Button Classes="small" Content="OPEN PROFILE FOLDER" Margin="0,0,8,8" Command="{Binding OpenUevrProfileFolderCommand}" CommandParameter="PFX" />
                      </WrapPanel>

                      <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="PINBALL M" Margin="0,6,0,0" />
                      <TextBlock Classes="body" Foreground="{StaticResource Text}" Text="{Binding PmStatus}" />
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" Text="{Binding PmProfileStatus}" />
                      <WrapPanel>
                        <Button Classes="small" Content="RESET TO PINBALL DEFAULTS" Margin="0,0,8,8" Command="{Binding ApplyPinballProfileCommand}" CommandParameter="PM" />
                        <Button Classes="small" Content="RESTORE MY ORIGINAL" Margin="0,0,8,8" IsVisible="{Binding PmHasUevrBackup}" Command="{Binding RestoreUevrOriginalCommand}" CommandParameter="PM" />
                        <Button Classes="small" Content="IMPORT PROFILE" Margin="0,0,8,8" Command="{Binding ImportUevrProfileCommand}" CommandParameter="PM" />
                        <Button Classes="small" Content="OPEN PROFILE FOLDER" Margin="0,0,8,8" Command="{Binding OpenUevrProfileFolderCommand}" CommandParameter="PM" />
                      </WrapPanel>

                      <WrapPanel>
                        <Button Classes="small" Content="UEVR DOWNLOAD PAGE" Margin="0,0,8,8" Command="{Binding OpenPageCommand}" CommandParameter="https://github.com/praydog/UEVR/releases" />
                        <Button Classes="small" Content="RECHECK" Margin="0,0,8,8" Command="{Binding RecheckSetupCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: UPDATES  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="updates" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 09 Updates -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=updates}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="09 · THIS APP" />
                    <TextBlock Classes="display" FontSize="42" Text="Updates" />
                    <TextBlock Classes="body" Text="New versions of this app, your tables and add-ons, VPX and UEVR, checked each time the app starts." />
                  </StackPanel>

                  <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="h2" Text="Updates" />
                            <Border Classes="chip hot" VerticalAlignment="Center"
                                    IsVisible="{Binding UpdateCount, Converter={x:Static v:Converters.NonZero}}">
                              <TextBlock Text="{Binding UpdateCount, StringFormat='{}{0} AVAILABLE'}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="mono" Text="{Binding LastChecked}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="CHECK NOW" Margin="0,0,8,0" Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding !IsCheckingUpdates}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="primary" Content="UPDATE ALL" Command="{Binding UpdateAllCommand}"
                                IsEnabled="{Binding !IsUpdating}" VerticalAlignment="Center" />
                      </Grid>
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingUpdates}" />

                      <Grid ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                          <Style Selector="Grid > TextBlock.k">
                            <Setter Property="FontFamily" Value="{StaticResource Display}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="LetterSpacing" Value="1.4" />
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,9" />
                          </Style>
                          <Style Selector="Grid > TextBlock.v">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                          </Style>
                        </Grid.Styles>

                        <TextBlock Grid.Row="0" Classes="k" Text="VR TABLE MANAGER" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                          <TextBlock Classes="v" Margin="0" Text="{Binding AppUpdateText}" />
                          <ProgressBar Value="{Binding AppUpdateProgress}" IsVisible="{Binding IsUpdatingApp}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="small" Content="RELEASE NOTES" Command="{Binding OpenAppReleasesCommand}" />
                          <Button Classes="small" Content="UPDATE APP" Command="{Binding UpdateAppCommand}"
                                  IsVisible="{Binding HasAppUpdate}" IsEnabled="{Binding !IsUpdatingApp}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Classes="k" Text="YOUR TABLES" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="v" Text="{Binding TableUpdateText}" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="small" Content="UPDATE TABLES" Command="{Binding UpdateAllTablesCommand}"
                                IsVisible="{Binding TableUpdateCount, Converter={x:Static v:Converters.NonZero}}" />

                        <TextBlock Grid.Row="2" Classes="k" Text="ADD-ONS" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="v" Text="{Binding AddonUpdateText}" />
                        <Button Grid.Row="2" Grid.Column="2" Classes="small" Content="UPDATE ADD-ONS" Command="{Binding UpdateAllAddonsCommand}"
                                IsVisible="{Binding AddonUpdateCount, Converter={x:Static v:Converters.NonZero}}" />

                        <TextBlock Grid.Row="3" Classes="k" Text="VISUAL PINBALL X" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="v" Text="{Binding VpxUpdateText}" />
                        <Button Grid.Row="3" Grid.Column="2" Classes="small" Content="UPDATE VPX" Command="{Binding InstallVpxCommand}"
                                IsVisible="{Binding HasVpxUpdate}" />

                        <TextBlock Grid.Row="4" Classes="k" Text="UEVR" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="v" Text="{Binding UevrUpdateText}" />
                        <Button Grid.Row="4" Grid.Column="2" Classes="small" Content="{Binding UevrButtonText}" Command="{Binding InstallUevrCommand}" />

                        <TextBlock Grid.Row="5" Classes="k" Text="BAM" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="v" Text="{Binding BamUpdateText}" />
                        <Button Grid.Row="5" Grid.Column="2" Classes="small" Content="BAM PAGE" Command="{Binding OpenPageCommand}"
                                CommandParameter="https://www.ravarcade.pl/" />

                        <TextBlock Grid.Row="6" Classes="k" Text="FUTURE PINBALL" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="v" Foreground="{StaticResource Muted}"
                                   Text="No updates. The final release came out in 2010; BAM is what keeps it current." />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Button Classes="small setupNext" Content="NEXT: MAINTENANCE  ›" Command="{Binding ShowSetupSectionCommand}" CommandParameter="maintenance" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- 10 Maintenance -->
            <ScrollViewer IsVisible="{Binding SetupSection, Converter={x:Static v:Converters.SectionIs}, ConverterParameter=maintenance}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="980" />
                </Grid.ColumnDefinitions>
                <StackPanel Classes="setupPage">
                  <StackPanel Classes="setupHead">
                    <TextBlock Classes="eyebrow" Text="10 · THIS APP" />
                    <TextBlock Classes="display" FontSize="42" Text="Maintenance" />
                    <TextBlock Classes="body" Text="When something goes wrong, what's using space, and a backup of what you can't download again." />
                  </StackPanel>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Troubleshooting" />
                      <TextBlock Classes="body" Text="When a table crashes, closes straight away or opens on the monitor instead of the headset, VPX's log usually says why." />
                      <CheckBox Content="When a VPX table crashes or closes within seconds, show what its log says" IsChecked="{Binding ExplainFailedLaunches}" />
                      <WrapPanel>
                        <Button Classes="small primary" Content="VIEW LAST VPX RUN" Margin="0,0,8,8" Command="{Binding ViewLastVpxLogCommand}" />
                        <Button Classes="small" Content="OPEN VR SETTINGS FILE" Margin="0,0,8,8" Command="{Binding OpenVrIniCommand}" />
                        <Button Classes="small" Content="OPEN LOBBY PLAY LOG" Margin="0,0,8,8" Command="{Binding OpenPlayLogCommand}"
                                ToolTip.Tip="What happened when tables were launched from the VR lobby" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Data folders" />
                      <WrapPanel Margin="0,4,0,0">
                        <Button Classes="small" Content="APP DATA" Margin="0,0,8,8" Command="{Binding OpenDataFolderCommand}"
                                ToolTip.Tip="Settings, favourites, play stats, catalog and caches" />
                        <Button Classes="small" Content="VPX SETTINGS &amp; LOGS" Margin="0,0,8,8" Command="{Binding OpenVpxPrefsFolderCommand}"
                                ToolTip.Tip="%APPDATA%\VPinballX: VPX's own settings, log and caches" />
                        <Button Classes="small" Content="UEVR" Margin="0,0,8,8" Command="{Binding OpenUevrFolderCommand}" />
                        <Button Classes="small" Content="FUTURE PINBALL" Margin="0,0,8,8" Command="{Binding OpenFpFolderCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="h2" Text="Storage" />
                          <TextBlock Classes="mono" Text="{Binding StorageStatus}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="small" Content="⟳  CHECK SIZES" VerticalAlignment="Center"
                                Command="{Binding RefreshStorageCommand}" IsEnabled="{Binding !IsSurveyingStorage}" />
                      </Grid>
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSurveyingStorage}" />
                      <TextBlock Classes="muted" Text="Press Check sizes to see what's using space." IsVisible="{Binding Storage.Count, Converter={x:Static v:Converters.IsZero}}" />
                      <ItemsControl ItemsSource="{Binding Storage}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="services:StorageEntry">
                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                              <Grid ColumnDefinitions="90,*,Auto,Auto">
                                <TextBlock Classes="dmd" FontSize="16" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                  <TextBlock Classes="title" FontSize="13.5" Text="{Binding Name}" />
                                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="small" Content="OPEN" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{ReflectionBinding $parent[Window].DataContext.OpenStorageCommand}" CommandParameter="{Binding}" />
                                <Button Grid.Column="3" Classes="small danger" Content="CLEAR" Margin="8,0,0,0" VerticalAlignment="Center"
                                        IsVisible="{Binding CanClear}"
                                        Command="{ReflectionBinding $parent[Window].DataContext.ClearStorageCommand}" CommandParameter="{Binding}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="h2" Text="Backup &amp; restore" />
                      <TextBlock Classes="body"
                                 Text="Saves what you can't download again: favourites and play stats, app and VPX settings, each table's settings and high scores, and your UEVR profiles. Tables and ROMs aren't included (they can be downloaded again), so backups stay small." />
                      <WrapPanel>
                        <Button Classes="small primary" Content="BACK UP NOW" Margin="0,0,8,8" Command="{Binding CreateBackupCommand}" />
                        <Button Classes="small" Content="RESTORE…" Margin="0,0,8,8" Command="{Binding RestoreBackupCommand}" />
                        <Button Classes="small" Content="OPEN BACKUPS FOLDER" Margin="0,0,8,8" Command="{Binding OpenBackupsFolderCommand}" />
                      </WrapPanel>
                      <TextBlock Classes="body" Foreground="{StaticResource Lamp}" Text="{Binding BackupStatus}" TextWrapping="Wrap"
                                 IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Classes="mono" TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="Table data from the Virtual Pinball Spreadsheet (virtualpinballspreadsheet.github.io). This app doesn't host tables. Thank the authors on the sites you download from. High scores: this program makes use of content from the Pinball Memory Maps project (github.com/tomlogic/pinball-memory-maps), available under the Open Database License (ODbL) v1.0." />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Panel>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Logo, drawn over the left side of the header bar -->
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="26,0,0,0" Height="64" VerticalAlignment="Top"
                HorizontalAlignment="Left" IsHitTestVisible="False">
      <Image Source="/Assets/app-icon.png" Width="42" Height="42" VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <TextBlock FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="26" LetterSpacing="1.2"
                   VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="TABLE MANAGER" />
      </StackPanel>
    </StackPanel>

    <!-- Downloads tray: installs and updates from any tab -->
    <Border Grid.Row="1" Background="#0E0E10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Padding="28,14" MaxHeight="220"
            IsVisible="{Binding Jobs.Count, Converter={x:Static v:Converters.NonZero}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Classes="small" Content="CLEAR FINISHED" Command="{Binding ClearFinishedJobsCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Classes="eyebrow" Text="DOWNLOADS" VerticalAlignment="Center" />
            <TextBlock Classes="mono" VerticalAlignment="Center" Text="{Binding MaxParallelDownloads, StringFormat='{}{0} at a time · change on Setup'}" />
          </StackPanel>
        </DockPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JobItem">
                <Grid ColumnDefinitions="280,200,*,Auto">
                  <TextBlock Classes="title" FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Margin="12,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" FontSize="12.5" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{Binding IsError, Converter={x:Static v:Converters.ErrorBrush}}" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="small" Content="OPEN PAGE AGAIN" Command="{Binding OpenWaitingPageCommand}"
                            IsVisible="{Binding IsWaitingForUser}" ToolTip.Tip="Opens the file's page in your browser again" />
                    <Button Classes="small" Content="I SAVED IT…" IsVisible="{Binding IsWaitingForUser}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PickDownloadedFileCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Saved the file somewhere other than your Downloads folder? Point to it." />
                    <Button Classes="small primary" Content="DONE" Command="{Binding DoneWaitingCommand}" IsVisible="{Binding WaitingForMany}"
                            ToolTip.Tip="Finished downloading the files you want from this page" />
                    <Button Classes="small danger" Content="CANCEL" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                    <Button Classes="small" Content="✕" IsVisible="{Binding !IsRunning}" ToolTip.Tip="Remove from the list"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissJobCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
