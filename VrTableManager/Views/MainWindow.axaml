<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VrTableManager.ViewModels"
        xmlns:v="using:VrTableManager.Views"
        xmlns:mt="using:VrTableManager.Views.MyTables"
        xmlns:gt="using:VrTableManager.Views.GetTables"
        xmlns:setup="using:VrTableManager.Views.Setup"
        xmlns:services="using:VrTableManager.Services"
        x:Class="VrTableManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VR Table Manager"
        Icon="/Assets/app.ico"
        Width="1360" Height="880" MinWidth="980" MinHeight="640">

  <!-- Each tab is its own view: MyTables/, GetTables/, Setup/ (one file per section). -->
  <Window.Styles>
    <StyleInclude Source="/Views/Shared/CardStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- Header bar behind the nav tabs -->
    <!-- Black lacquer with a chrome trim line, like a cabinet's lockbar edge -->
    <Border Height="66" VerticalAlignment="Top">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#1A1A1D" />
          <GradientStop Offset="1" Color="#0A0A0B" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Height="2" Margin="0,64,0,0" VerticalAlignment="Top" Background="{StaticResource Chrome}" Opacity="0.55" />

    <TabControl Classes="nav">
      <TabControl.Styles>
        <Style Selector="TabControl.nav /template/ ItemsPresenter#PART_ItemsPresenter">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Margin" Value="0,14,24,14" />
        </Style>
      </TabControl.Styles>

      <!-- ================= My tables ================= -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="MY TABLES" VerticalAlignment="Center" />
            <Border Classes="chip hot" Padding="6,1" VerticalAlignment="Center"
                    IsVisible="{Binding Library.TableUpdateCount, Converter={x:Static v:Converters.NonZero}}"
                    ToolTip.Tip="Table updates available">
              <TextBlock Text="{Binding Library.TableUpdateCount}" />
            </Border>
          </StackPanel>
        </TabItem.Header>
        <mt:MyTablesView DataContext="{Binding Library}" />
      </TabItem>

      <!-- ================= Get tables ================= -->
      <TabItem Header="GET TABLES">
        <gt:GetTablesView DataContext="{Binding Catalog}" />
      </TabItem>

      <!-- ================= Setup ================= -->
      <!-- A rail of sections on the left, one section at a time on the right: Setup had grown into one long
           scroll. VPX and its folders come first, because nothing else works without them. -->
      <TabItem Header="SETUP">
        <setup:SetupView />
      </TabItem>
    </TabControl>

    <!-- Logo, drawn over the left side of the header bar -->
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="26,0,0,0" Height="64" VerticalAlignment="Top"
                HorizontalAlignment="Left" IsHitTestVisible="False">
      <Image Source="/Assets/app-icon.png" Width="42" Height="42" VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <TextBlock FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="26" LetterSpacing="1.2"
                   VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="TABLE MANAGER" />
      </StackPanel>
    </StackPanel>

    <!-- Downloads tray: installs and updates from any tab -->
    <Border Grid.Row="1" Background="#0E0E10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Padding="28,14" MaxHeight="220"
            IsVisible="{Binding Downloads.Jobs.Count, Converter={x:Static v:Converters.NonZero}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Classes="small" Content="CLEAR FINISHED" Command="{Binding Downloads.ClearFinishedJobsCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Classes="eyebrow" Text="DOWNLOADS" VerticalAlignment="Center" />
            <TextBlock Classes="mono" VerticalAlignment="Center" Text="{Binding Downloads.MaxParallelDownloads, StringFormat='{}{0} at a time · change on Setup'}" />
          </StackPanel>
        </DockPanel>
        <!-- Only the rows on screen are built: a batch over a big library leaves hundreds of finished jobs here. -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Downloads.Jobs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JobItem">
                <Grid ColumnDefinitions="280,200,*,Auto" Margin="0,0,0,8">
                  <TextBlock Classes="title" FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Margin="12,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" FontSize="12.5" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{Binding IsError, Converter={x:Static v:Converters.ErrorBrush}}" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="small" Content="OPEN PAGE AGAIN" Command="{Binding OpenWaitingPageCommand}"
                            IsVisible="{Binding IsWaitingForUser}" ToolTip.Tip="Opens the file's page in your browser again" />
                    <Button Classes="small" Content="I SAVED IT…" IsVisible="{Binding IsWaitingForUser}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Downloads.PickDownloadedFileCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Saved the file somewhere other than your Downloads folder? Point to it." />
                    <Button Classes="small primary" Content="DONE" Command="{Binding DoneWaitingCommand}" IsVisible="{Binding WaitingForMany}"
                            ToolTip.Tip="Finished downloading the files you want from this page" />
                    <Button Classes="small danger" Content="CANCEL" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                    <Button Classes="small" Content="✕" IsVisible="{Binding !IsRunning}" ToolTip.Tip="Remove from the list"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Downloads.DismissJobCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
