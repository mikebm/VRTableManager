<!-- The My Tables tab: filters and the grid of installed tables (each a TableCard), with its A–Z rail. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VrTableManager.ViewModels"
             xmlns:v="using:VrTableManager.Views"
             xmlns:services="using:VrTableManager.Services"
             xmlns:mt="using:VrTableManager.Views.MyTables"
             xmlns:sh="using:VrTableManager.Views.Shared"
             x:Class="VrTableManager.Views.MyTables.MyTablesView"
             x:DataType="vm:LibraryViewModel">
  <!-- Everything above the cards stays put; only the cards scroll. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,14,28,6" Spacing="10">
      <!-- One line: title and count, buttons on the right. How Play works is the title's tooltip. -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                    ToolTip.Tip="Hit Play in VR, then put your headset on. This window gets out of the way and comes back when the table closes, so you can pick the next one.">
          <TextBlock Classes="h2" Text="My Tables" VerticalAlignment="Center" />
          <TextBlock Classes="eyebrow" Text="{Binding InstalledTotal, StringFormat='{}{0} INSTALLED'}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="＋  ADD A TABLE FILE…" Command="{Binding AddTableFileCommand}"
                  ToolTip.Tip="Install a table zip (or .vpx / .fpt) you already downloaded yourself" />
          <Button Content="⟳  RESCAN" Command="{Binding RefreshInstalledCommand}" />
          <Button Content="◆  GET LOBBY MEDIA" Command="{Binding App.Media.GetAllLobbyMediaCommand}" IsVisible="{Binding !App.Media.IsBatchRecording}"
                  ToolTip.Tip="For every table shown: fills in what's missing of its playfield video, loading video, attract audio and wheel art from the catalog's media packs, then can record playfield videos in VPX for the rest. Search or filter first to do only some tables." />
          <Button Content="{Binding App.Media.BatchRecordingText}" Command="{Binding App.Media.StopBatchRecordingCommand}" IsVisible="{Binding App.Media.IsBatchRecording}"
                  ToolTip.Tip="Stops the table that's being done (its download or VPX recording) and skips the rest" />
          <Button Classes="primary" Content="◉  LAUNCH VR LOBBY" Command="{Binding App.Lobby.LaunchLobbyCommand}"
                  IsEnabled="{Binding !App.Lobby.IsLobbyRunning}"
                  ToolTip.Tip="Pick and play tables inside the headset. First time: downloads Godot (117 MB) and builds the lobby." />
        </StackPanel>
      </Grid>
      <TextBlock Foreground="{StaticResource Lamp}" FontWeight="SemiBold" Text="{Binding PlayStatus}" TextWrapping="Wrap"
                 IsVisible="{Binding PlayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Table updates banner: one slim line -->
      <Border CornerRadius="10" Padding="14,6" BorderBrush="{StaticResource Insert}" BorderThickness="1" Background="#14E5483B"
              IsVisible="{Binding TableUpdateCount, Converter={x:Static v:Converters.NonZero}}"
              ToolTip.Tip="Authors released newer versions. Updating keeps your ROMs, high scores and table settings.">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="18" Foreground="{StaticResource Insert}"
                     Text="{Binding TableUpdateCount}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="title" Text="{Binding TableUpdateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="SHOW THEM" Command="{Binding ShowTableUpdatesCommand}"
                    ToolTip.Tip="Shows only the tables with a newer version (the Updates filter), so you can update them one by one" />
            <Button Classes="primary" Content="UPDATE ALL TABLES" Command="{Binding UpdateAllTablesCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <WrapPanel IsVisible="{Binding InstalledTotal, Converter={x:Static v:Converters.NonZero}}">
        <TextBox Text="{Binding InstalledSearch}" Classes.active="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" PlaceholderText="Search your tables" Width="260" ToolTip.Tip="Name, maker, author, theme, year or ROM. Typos are fine, words can be in any order, and initials work: afm, tz, mm" Margin="0,0,12,8">
          <TextBox.InnerLeftContent>
            <PathIcon Classes="search" Margin="12,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <ListBox Classes="segmented" ItemsSource="{Binding InstalledFilters}" SelectedItem="{Binding InstalledFilter}" Margin="0,0,12,8" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding InstalledEngines}" SelectedItem="{Binding InstalledEngine}" MinWidth="150" Margin="0,0,12,8" VerticalAlignment="Center" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding InstalledMakers}" SelectedItem="{Binding InstalledMakerFilter}" MinWidth="150" MaxDropDownHeight="420" Margin="0,0,12,8" VerticalAlignment="Center" ToolTip.Tip="Manufacturer" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding App.Catalog.Eras}" SelectedItem="{Binding InstalledEraFilter}" MinWidth="130" Margin="0,0,12,8" VerticalAlignment="Center" ToolTip.Tip="When the real machine came out" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding App.Catalog.MachineTypes}" SelectedItem="{Binding InstalledTypeFilter}" MinWidth="150" Margin="0,0,12,8" VerticalAlignment="Center" ToolTip.Tip="Solid state (1977 on), electro-mechanical, or original designs. From the catalog, so tables not linked to it only show under Any type" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding InstalledThemeFilter}" MinWidth="150" MaxDropDownHeight="420" Margin="0,0,12,8" VerticalAlignment="Center" ToolTip.Tip="What the machine is about, from the catalog" />
        <ComboBox Classes.active="{Binding $self.SelectedIndex, Converter={x:Static v:Converters.NonZero}}" ItemsSource="{Binding InstalledCollections}" SelectedItem="{Binding InstalledCollectionChoice}" MinWidth="190" MaxDropDownHeight="520" Margin="0,0,8,8" VerticalAlignment="Center"
                  ToolTip.Tip="Your own collections, then smart ones that fill themselves (Never played, New this month … and ones you save). All are filters in the VR lobby too (B / Tab)">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CollectionOption">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding CountText}" Opacity="0.65"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Classes.eyebrow="{Binding IsHeader}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.Styles>
            <Style Selector="ComboBoxItem" x:DataType="vm:CollectionOption">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
            </Style>
          </ComboBox.Styles>
        </ComboBox>
        <Button Classes="small" Content="RENAME" Margin="0,0,8,8" VerticalAlignment="Center"
                IsVisible="{Binding CanEditCollection}" Command="{Binding RenameCollectionCommand}" />
        <Button Classes="small" Content="DELETE" Margin="0,0,12,8" VerticalAlignment="Center"
                ToolTip.Tip="Deletes the collection only; your tables stay installed"
                IsVisible="{Binding CanEditCollection}" Command="{Binding DeleteCollectionCommand}" />
        <Button Classes="small" Content="SAVE AS SMART" Margin="0,0,12,8" VerticalAlignment="Center"
                ToolTip.Tip="Keeps this search and these filters as a smart collection, which stays up to date as your tables change"
                IsVisible="{Binding CanSaveSmart}" Command="{Binding SaveSmartCollectionCommand}" />
        <Button Classes="small" Content="CLEAR FILTERS" Margin="0,0,12,8" VerticalAlignment="Center"
                IsVisible="{Binding HasInstalledFilters}" Command="{Binding ClearInstalledFiltersCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="SORT" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding InstalledSorts}" SelectedItem="{Binding InstalledSort}" MinWidth="170"
                    ToolTip.Tip="Used with All; the other lists have their own order" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Foreground="{StaticResource Muted}" Text="SIZE" VerticalAlignment="Center" />
          <ListBox Classes="segmented" ItemsSource="{Binding CardSizes}" SelectedItem="{Binding CardSize}"
                   ToolTip.Tip="Card size: Text shows no pictures, so many more tables fit" />
        </StackPanel>
        <TextBlock Classes="mono shownCount" Classes.narrowed="{Binding IsInstalledNarrowed}" VerticalAlignment="Center" Margin="0,0,16,8"
                   Text="{Binding InstalledShownText}"
                   ToolTip.Tip="How many tables the search and filters show, of all you have installed" />
        <TextBlock Classes="mono" VerticalAlignment="Center" Margin="0,0,0,8"
                   Text="{Binding InstalledSizeText, StringFormat='{}{0} on disk'}"
                   ToolTip.Tip="Favourites and plays are shared with the VR lobby" />
      </WrapPanel>
      <TextBlock Classes="body" Text="{Binding InstalledEmptyText}"
                 IsVisible="{Binding InstalledEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="panel" IsVisible="{Binding InstalledTotal, Converter={x:Static v:Converters.IsZero}}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="No tables yet" />
          <TextBlock Classes="body" Text="Go to Get Tables, pick a table with the VR badge and press Install." />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- A–Z rail: a letter jumps to its first table, as in the VR lobby (only while the list is A–Z). -->
    <ItemsControl DockPanel.Dock="Right" Classes="letterRail" Margin="0,8,6,8"
                  x:Name="InstalledLetterRail" ItemsSource="{Binding InstalledLetters}" IsVisible="{Binding ShowInstalledLetters}" />
    <!-- Cards in rows (CardRows, set in code: as many across as fit), and only the rows on screen are built. -->
    <ScrollViewer x:Name="InstalledScroll">
      <ItemsControl x:Name="InstalledGrid" Margin="28,8,28,28">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sh:CardRow">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InstalledItem">
                  <mt:TableCard />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
