<!-- Setup → 07 VR lobby. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VrTableManager.ViewModels"
             xmlns:v="using:VrTableManager.Views"
             xmlns:services="using:VrTableManager.Services"
             x:Class="VrTableManager.Views.Setup.LobbySection"
             x:DataType="vm:LobbyViewModel">
  <ScrollViewer>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="980" />
      </Grid.ColumnDefinitions>
      <StackPanel Classes="setupPage">
        <StackPanel Classes="setupHead">
          <TextBlock Classes="eyebrow" Text="07 · VIRTUAL REALITY" />
          <TextBlock Classes="display" FontSize="42" Text="VR lobby" />
          <TextBlock Classes="body" Text="Your tables as pinball cabinets standing round you in an arcade, started with LAUNCH VR LOBBY on My Tables. Pick one in the headset and it plays." />
        </StackPanel>

        <!-- How big the cabinets are and how many stand in the ring (LobbyLayout); the lobby reads them when it starts. -->
        <Border Classes="panel" BorderBrush="{StaticResource LineHi}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Cabinets" />
            <Grid ColumnDefinitions="210,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <TextBlock Text="Cabinet size" VerticalAlignment="Center" FontWeight="SemiBold" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding LobbyCabinetScales}" SelectedItem="{Binding LobbyCabinetScale}" Width="150">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:Int32">
                    <TextBlock Text="{Binding StringFormat='{}{0} %'}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="100 % is a real machine. Smaller cabinets leave more room round you; bigger ones keep the same gap between them, so the ring moves back." />

              <TextBlock Grid.Row="1" Text="Cabinets in the ring" VerticalAlignment="Center" FontWeight="SemiBold" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LobbyCabinetCounts}" SelectedItem="{Binding LobbyCabinetCount}" Width="150" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="The one you've picked and as many either side. More than 11 stand closer together round a bigger ring, and each one costs the headset a little frame rate." />
            </Grid>
            <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding LobbyRingSummary}" />
            <StackPanel Spacing="4">
              <TextBlock Text="Cabinet style" FontWeight="SemiBold" />
              <RadioButton GroupName="LobbyCabinetStyle" IsChecked="{Binding LobbyOwnCabinets}"
                           Content="The table's own VR cabinet, when its file has one"
                           ToolTip.Tip="VR tables carry a cabinet of their own, with the game's side art and backbox. Tables without one stand on the generic cabinet." />
              <RadioButton GroupName="LobbyCabinetStyle" IsChecked="{Binding LobbyGenericCabinets}"
                           Content="Always the generic cabinet, wearing the table's playfield and backglass"
                           ToolTip.Tip="Every table looks alike apart from its art, and the lobby doesn't read the tables' own cabinets. For a few tables only, use MORE → My artwork on My Tables." />
            </StackPanel>
            <WrapPanel>
              <Button Classes="small" Content="RESET TO DEFAULTS" Margin="0,0,8,0" Command="{Binding ResetLobbyCabinetsCommand}"
                      ToolTip.Tip="Real-size cabinets, 11 in the ring: the lobby as it always was." />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The lobby reads these when it starts: one already open, or waiting hidden behind a table, keeps its ring until you quit it." />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Starting tables" />
            <CheckBox IsChecked="{Binding LobbyWaitsForTable}"
                      Content="Show a loading screen in the VR lobby while a table starts"
                      ToolTip.Tip="The lobby stays in the headset until the table takes it over, and says so if the table fails to start. Turn it off if tables won't open in VR while the lobby is waiting (some OpenXR runtimes allow only one VR app at a time)." />
            <CheckBox IsChecked="{Binding LobbyStaysOpen}" IsEnabled="{Binding LobbyWaitsForTable}"
                      Content="Keep the VR lobby open behind the table, for a quick return"
                      ToolTip.Tip="The lobby waits, hidden, while you play, and is back the moment the table closes instead of starting up again. It keeps its cabinets in memory meanwhile. Turn it off if a big table runs short of graphics memory." />
            <CheckBox IsChecked="{Binding LobbyLoadingVideos}" IsEnabled="{Binding LobbyWaitsForTable}"
                      Content="Play a loading video on the loading screen"
                      ToolTip.Tip="A big screen shows the table's loading video, with its sound, until the table takes the headset over. A table gets its own from MORE (media pack, or your own video); the one below plays for the rest." />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Loading video for every table without its own:" />
            <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding DefaultLoadingVideoText}" />
            <WrapPanel>
              <Button Classes="small" Content="CHOOSE A VIDEO…" Margin="0,0,8,0" Command="{Binding ChooseDefaultLoadingVideoCommand}"
                      ToolTip.Tip="Any video file (.mp4 works best), such as one of the generic loading videos front-end users share. The first 30 seconds are used, with their sound." />
              <Button Classes="small" Content="ROTATE…" Margin="0,0,8,0" IsVisible="{Binding HasDefaultLoadingVideo}" Command="{Binding RotateDefaultLoadingVideoCommand}"
                      ToolTip.Tip="Turns it a quarter, clockwise or anticlockwise, for a video made sideways for a cabinet's screen. Its shape turns with it." />
              <Button Classes="small" Content="REMOVE" IsVisible="{Binding HasDefaultLoadingVideo}" Command="{Binding RemoveDefaultLoadingVideoCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- What the lobby reads from each table file the first time it shows it, and switching off the playfield videos. -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Tables in the ring" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The first time the lobby shows a table, it reads the table's file for its cabinet and playfield: a few seconds a table, longer on a hard drive. Prepare them all now and every table comes round the ring at once. Only tables not yet prepared (new or updated ones) are read again." />
            <WrapPanel>
              <Button Classes="small" Content="PREPARE TABLES" Margin="0,0,8,0" Command="{Binding PrepareLobbyTablesCommand}"
                      IsEnabled="{Binding !IsPreparingLobbyTables}"
                      ToolTip.Tip="Reads every table now, in the background: follow it under Downloads. A big library on a hard drive can take an hour or more the first time; you can keep using the app meanwhile." />
            </WrapPanel>
            <CheckBox IsChecked="{Binding LobbyPlayfieldVideos}"
                      Content="Play lobby videos on the cabinets' playfields"
                      ToolTip.Tip="Every cabinet you can see plays its table's lobby video on its playfield, with the ramps and toys standing up, so the ones you turn towards are already moving. Turn it off on a slower PC or a hard drive: playfields stay still pictures, and the lobby doesn't read the videos at all." />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Music" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="When you stop on a table, the lobby plays its music from the backbox: a sound file in the table's folder (from a media pack, say), or for a ROM table without one, music recorded from its ROM. Recording runs the ROM in real time, so it's best done ahead of time. Only ROM tables without music are recorded, and each only once." />
            <Grid ColumnDefinitions="210,Auto,*" ColumnSpacing="12">
              <TextBlock Text="Music length" VerticalAlignment="Center" FontWeight="SemiBold" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AttractMusicLengths}" SelectedItem="{Binding AttractMusicSeconds}" Width="150">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:Int32">
                    <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="How long the lobby plays a table's music. A recording keeps this much; after a change, GENERATE ATTRACT MUSIC records them again (the old ones play meanwhile)." />
            </Grid>
            <WrapPanel>
              <Button Classes="small" Content="GENERATE ATTRACT MUSIC" Margin="0,0,8,0" Command="{Binding GenerateAttractMusicCommand}"
                      IsEnabled="{Binding !IsGeneratingAttractMusic}"
                      ToolTip.Tip="Records the music of every ROM table that has none yet, several at a time, in the background: follow it under Downloads. Each takes about half a minute plus the music length. GET LOBBY MEDIA and PREPARE TABLES can do this too." />
            </WrapPanel>
            <CheckBox IsChecked="{Binding LobbyRecordsRomAudio}"
                      Content="Let the VR lobby record a table's music when it has none yet"
                      ToolTip.Tip="For a table you stop on that wasn't recorded ahead of time: one table at a time, in the background, and it plays after about half a minute if you're still there. Off: the lobby only plays music that's already there." />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Cabinet feedback (DOF)" />
            <CheckBox IsChecked="{Binding LobbyDof}"
                      Content="Fire the cabinet's DOF effects in the VR lobby"
                      ToolTip.Tip="The lobby runs your DirectOutput (DOF) the way PinUP Popper's menu does, with your usual DOF config. It lets go of DOF before a table starts, so the table's own DOF works as normal." />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The effects are the ones set up for PinUP Popper's menu: the &quot;pinupmenu&quot; table in the DOF Config Tool. Flippers fire GamePrior / GameNext (E800 / E801), magna-saves PagePrior / PageNext (E805 / E804), Start GameStart (E806), Coin ListNext (E802), and favourites FavAdd / FavDel (E816 / E817). After changing them in the Config Tool, download and install your config again." />
            <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding DofStatusText}" />
          </StackPanel>
        </Border>

        <Button Classes="small setupNext" Content="NEXT: DOWNLOADS  ›" Command="{Binding App.ShowSetupSectionCommand}" CommandParameter="downloads" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
