<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VrTableManager.ViewModels"
        xmlns:v="using:VrTableManager.Views"
        xmlns:services="using:VrTableManager.Services">
  <!-- Setup's section rail: each section is a lamp switch, lit like the top tabs when it's the one showing.
       Radio buttons with their own template (no dot), so exactly one is on and the keyboard can move between them. -->
  <Style Selector="RadioButton.setupNav">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="navBack" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="navContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.setupNav:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="RadioButton.setupNav:checked">
    <Setter Property="Background" Value="{StaticResource LampSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
    <Setter Property="Foreground" Value="{StaticResource Lamp}" />
  </Style>
  <Style Selector="RadioButton.setupNav:checked /template/ Border#navBack">
    <Setter Property="BoxShadow" Value="0 0 14 0 #33FFB23E" />
  </Style>
  <Style Selector="RadioButton.setupNav TextBlock.navNum">
    <Setter Property="FontFamily" Value="{StaticResource DmdFont}" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="RadioButton.setupNav TextBlock.navTitle">
    <Setter Property="FontFamily" Value="{StaticResource Display}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="RadioButton.setupNav TextBlock.navSub">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.railGroup">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="#6E6E77" />
    <Setter Property="Margin" Value="10,14,0,4" />
  </Style>
  <!-- A Setup page sits in a grid column capped at 980 px, so it fills the width up to that from the left
       (a StackPanel with a MaxWidth of its own would centre itself in a wide window). -->
  <Style Selector="StackPanel.setupPage">
    <Setter Property="Margin" Value="32,24,32,32" />
    <Setter Property="Spacing" Value="16" />
  </Style>
  <Style Selector="StackPanel.setupHead">
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Button.setupNext">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
</Styles>
